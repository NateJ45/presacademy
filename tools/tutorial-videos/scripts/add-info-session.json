    },
    {
      "do": "press",
      "key": "ArrowRight"
    },
    {
      "do": "press",
      "key": "0"
    },
    {
      "do": "press",
      "key": "7"
    },
    {
      "do": "press",
      "key": "0"
    },
    {
      "do": "press",
      "key": "0"
    },
    {
      "do": "press",
      "key": "P"
    },
    {
      "do": "press",
      "key": "M"
    },
    {
      "do": "wait",
      "ms": 900
    },
    {
      "do": "ring",
