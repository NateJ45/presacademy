{
  // Cloudflare Workers configuration for this project.
  // Cloudflare merged Pages into Workers in early 2026; Workers is the path forward.
  "compatibility_date": "2026-05-26",
  // nodejs_compat: the SSR preview routes' render graph can touch process.env
  // (React internals, Sanity client) — without the flag those reads throw at
  // request time. global_fetch_strictly_public predates it.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Cloudflare Worker name. Must match the Worker created in the Cloudflare dashboard.
  "name": "presacademy",

  // ---- The forms' own endpoint (src/pages/api/contact.ts, starter card 45) ----
  // Every Sanity-built form posts to /api/contact/, which STORES the submission
  // in D1 first and emails the Academy second, so a failed send never loses an
  // enquiry. Wired 2026-10-13, replacing Web3Forms + hCaptcha.
  //
  // presbyterianacademy.org had no mail provider at all, so this site uses
  // Email ROUTING on the root domain (MX at Cloudflare) rather than Email
  // Sending: the notification goes to a VERIFIED destination address, which is
  // free on any plan. The address is the CONTACT_TO secret and is deliberately
  // not written anywhere in this repo. CONTACT_FROM (an address on this domain)
  // and TURNSTILE_SECRET are secrets too: `npx wrangler secret put <NAME>`.
  //
  // The database was created and migrated remotely on 2026-10-13. To recreate:
  //   npx wrangler d1 create presacademy-contact
  //   npx wrangler d1 migrations apply presacademy-contact --remote
  // migrations/ is generated: `npm run contact:migration` rewrites it from
  // SUBMISSIONS_DDL in src/lib/contact-submission.ts.
  //
  // LOCAL D1 STATE IS KEYED PER CONFIG PATH. `wrangler dev` runs against the
  // generated dist/server/wrangler.json, so apply the migration the same way:
  //   npx wrangler d1 migrations apply presacademy-contact --local -c dist/server/wrangler.json
  // A migration applied with this root config lands in a different local
  // database and the endpoint answers "no such table".
  //
  // Reading submissions: OPERATIONS.md, "Form submissions".
  "d1_databases": [
    {
      "binding": "CONTACT_DB",
      "database_name": "presacademy-contact",
      "database_id": "5b332eae-956e-490c-b1b8-3160a9147e20",
      "migrations_dir": "migrations",
    },
  ],
  "send_email": [{ "name": "EMAIL" }],

  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    // @astrojs/cloudflare v14 splits the build into dist/client (static assets)
    // + dist/server (the SSR bundle: /preview/**, /api/draft-mode/*, /studio).
    //
    // Deliberately NO "not_found_handling" here. With "404-page" set, Cloudflare
    // answers NAVIGATION requests (Sec-Fetch-Mode: navigate) that miss the asset
    // store straight from the static 404 page WITHOUT invoking the Worker — which
    // silently 404'd every SSR route for real browsers while curl (which sends no
    // Sec-Fetch headers) saw them working. That broke the Presentation preview in
    // production on 2026-08-26 and hid from every command-line probe. Without the
    // field, asset misses invoke the Worker and Astro renders the 404 page itself
    // (exactly the WCP repo's shape).
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  // Plain (non-secret) runtime values.
  //
  // CF_ACCOUNT_ID names the Cloudflare account whose Web Analytics the Studio
  // Home's Visitors card reads (src/pages/api/studio/visitors.ts, PORTS.md card
  // 115). An account id NAMES an account, it does not open one, so it is not a
  // secret. Its partners: CF_WEB_ANALYTICS_SITE_TAG (a var, added here once the
  // Web Analytics site exists; OPERATIONS.md "Visitor numbers") and
  // CF_ANALYTICS_TOKEN, a real secret (Account Analytics · Read, one
  // permission, read-only), set with `npx wrangler secret put
  // CF_ANALYTICS_TOKEN` and never written here. Same account as the WCP site.
  //
  // The Studio's other Worker secrets (none written here): SHARE_PREVIEW_SECRET
  // (private preview links, card 117). GITHUB_DEPLOY_TOKEN is NOT used: this
  // site deploys through Cloudflare Workers Builds, not a GitHub workflow, so
  // the deploy-status route answers "not configured" and the Studio's status
  // line compares the build time with the last publish instead.
  "vars": {
    "CF_ACCOUNT_ID": "7e75a15ddc72aae04dca71aca5c7294b",
  },
  "observability": {
    "enabled": true,
  },
}
