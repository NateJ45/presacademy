{
  "name": "ncs-presacademy",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/free-dist.mjs",
    "build": "node scripts/generate-og-pages.mjs && node scripts/with-workerd.mjs astro build",
    "build:full": "npm run typegen && npm run build",
    "preview": "wrangler dev -c dist/server/wrangler.json",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json",
    "generate-types": "wrangler types",
    "typegen": "sanity schema extract --force && sanity typegen generate",
    "og": "node scripts/generate-og-default.mjs",
    "og:pages": "node scripts/generate-og-pages.mjs",
    "llms:full": "node scripts/generate-llms-full.mjs",
    "studio-thumbs": "node scripts/studio-thumbs.mjs",
    "publish-due": "node scripts/publish-due.mjs",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "serve:dist": "http-server dist/client -p 4321 -c-1 --silent",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.6",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/astro": "3.4.2",
    "@sanity/client": "7.23.0",
    "@sanity/icons": "^3.8.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "2.0.9",
    "@sanity/preview-url-secret": "4.0.8",
    "@sanity/ui": "3.3.5",
    "@sanity/vision": "6.4.0",
    "@sanity/visual-editing": "5.4.5",
    "@tabler/icons-react": "^3.44.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.23",
    "lucide-react": "^1.39.0",
    "motion": "^13.1.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-is": "19.2.8",
    "sanity": "6.4.0",
    "sanity-plugin-asset-source-unsplash": "7.0.15",
    "sanity-plugin-documents-pane": "4.1.8",
    "sanity-plugin-media": "5.0.11",
    "shadcn": "^4.19.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "styled-components": "6.5.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "wrangler": "~4.129.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.0",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^3.1.0",
    "http-server": "^14.1.1",
    "opentype.js": "^2.0.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.0",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "sanity-plugin-utils": "2.0.6",
    "@sanity/visual-editing": "5.4.5"
  }
}
