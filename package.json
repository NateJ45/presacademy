{
  "name": "ncs-presacademy",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-og-pages.mjs && astro build",
    "build:full": "npm run typegen && npm run build",
    "preview": "wrangler dev -c dist/server/wrangler.json",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json",
    "generate-types": "wrangler types",
    "typegen": "npm --prefix studio run typegen",
    "og": "node scripts/generate-og-default.mjs",
    "og:pages": "node scripts/generate-og-pages.mjs",
    "llms:full": "node scripts/generate-llms-full.mjs",
    "studio:dev": "npm --prefix studio run dev",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "serve:dist": "http-server dist/client -p 4321 -c-1 --silent",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.2",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "@portabletext/react": "^6.2.0",
    "@portabletext/types": "^4.0.2",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "^7.26.2",
    "@sanity/icons": "^5.2.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "^2.0.22",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/vision": "^6.11.0",
    "@sanity/visual-editing": "^6.1.1",
    "@tabler/icons-react": "^3.44.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.23",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "sanity": "^6.11.0",
    "sanity-plugin-asset-source-unsplash": "^7.0.25",
    "sanity-plugin-documents-pane": "^4.1.19",
    "sanity-plugin-media": "^5.0.13",
    "shadcn": "^4.8.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "wrangler": "~4.110.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.0",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^1.7.0",
    "http-server": "^14.1.1",
    "opentype.js": "^2.0.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.0",
    "typescript-eslint": "^8.61.0"
  }
}
