{
  "name": "ncs-presacademy",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/free-dist.mjs",
    "build": "node scripts/generate-og-pages.mjs && node scripts/with-workerd.mjs astro build",
    "build:full": "npm run typegen && npm run build",
    "preview": "wrangler dev -c dist/server/wrangler.json",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json",
    "generate-types": "wrangler types",
    "typegen": "sanity schema extract --force && sanity typegen generate",
    "og": "node scripts/generate-og-default.mjs",
    "og:pages": "node scripts/generate-og-pages.mjs",
    "llms:full": "node scripts/generate-llms-full.mjs",
    "studio-thumbs": "node scripts/studio-thumbs.mjs",
    "publish-due": "node scripts/publish-due.mjs",
    "restore:doc": "node scripts/restore-doc.mjs",
    "gen:studio-art": "node scripts/gen-studio-art.mjs",
    "check": "astro check && npm run lint",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "node --experimental-strip-types --test src/lib/*.test.ts && npm run test:scripts",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "serve:dist": "http-server dist/client -p 4321 -s -c-1 --silent",
    "check:links": "linkinator ./dist/client --recurse --skip \"^https?://(?!127\\.0\\.0\\.1)\" --skip \"/studio\" --skip \"/preview\" --skip \"/api\"",
    "sync-check": "node scripts/sync-check.mjs",
    "check:look": "node --experimental-strip-types scripts/check-studio-look.mjs",
    "audit:data": "node scripts/audit-data-vs-schema.mjs",
    "contact:migration": "node --experimental-strip-types scripts/gen-contact-migration.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/astro": "3.5.1",
    "@sanity/client": "8.9.0",
    "@sanity/icons": "5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "2.0.28",
    "@sanity/preview-url-secret": "4.1.5",
    "@sanity/ui": "4.4.9",
    "@sanity/vision": "6.19.0",
    "@sanity/visual-editing": "6.1.3",
    "@tabler/icons-react": "^3.49.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "sanity": "6.19.0",
    "sanity-plugin-asset-source-unsplash": "7.0.29",
    "sanity-plugin-documents-pane": "4.1.24",
    "sanity-plugin-media": "6.3.5",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "styled-components": "6.6.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "wrangler": "~4.129.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "groq-js": "2.0.0",
    "http-server": "^14.1.1",
    "linkinator": "^8.1.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.0",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "sanity-plugin-utils": "2.0.22",
    "@sanity/visual-editing": "6.1.3",
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.9.1"
    },
    "@module-federation/dts-plugin": {
      "undici": "7.30.1"
    },
    "miniflare": {
      "undici": "7.30.1",
      "sharp": "0.35.5"
    },
    "linkinator": {
      "undici": "8.12.2"
    },
    "@lhci/cli": {
      "uuid": "11.1.1"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    },
    "tmp": "0.2.6"
  }
}
