# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
# Worker runtime secrets for wrangler dev (SANITY_TOKEN for the preview routes)
.dev.vars

# wrangler local cache (Cloudflare adapter)
.wrangler/

# Playwright MCP artifacts (screenshots/snapshots from visual verification)
.playwright-mcp/

# generated artifacts
tmp/
schema.json

# transient commit message files
.git-commit-msg.tmp

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Local Sanity dataset backups (not versioned)
backups/

# Scratch placeholder-image sourcing tooling + downloads (curation only, not versioned).
# The curated picks are copied into src/assets/placeholders/ and committed; the
# raw download pools + one-off probe scripts stay local.
scripts/_*.mjs
scripts/_stock*/

# Impeccable live mode: ignore the local recovery journal; config.json stays tracked
.impeccable/live/sessions/

# seed uploader asset-id cache (scripts/lib/sanity-lib.mjs)
scripts/.asset-map.json

# Playwright + Lighthouse CI local artifacts (docs/TESTING.md)
test-results/
playwright-report/
.lighthouseci/
