{
  "name": "The Presbyterian Academy",
  "domain": "presbyterianacademy.org",
  "palette": {
    "theme": {
      "--color-primary": "#33503F",
      "--color-primary-dark": "#2A4233"
    },
    "light": {
      "--background": "#FAF8F4",
      "--foreground": "#1F1B18",
      "--primary": "#33503F",
      "--link": "#33503F"
    },
    "dark": {
      "--background": "#1E1A17",
      "--foreground": "#F1EAD9",
      "--primary": "#74A98A",
      "--link": "#9CC6AC"
    }
  },
  "fonts": {
    "display": {
      "familyValue": "\"Fraunces Variable\", Georgia, \"Times New Roman\", serif",
      "imports": [
        "@fontsource-variable/fraunces/standard.css",
        "@fontsource-variable/fraunces/standard-italic.css"
      ]
    },
    "body": {
      "familyValue": "\"Source Sans 3 Variable\", system-ui, -apple-system, sans-serif",
      "imports": [
        "@fontsource-variable/source-sans-3/index.css",
        "@fontsource-variable/source-sans-3/wght-italic.css"
      ]
    }
  },
  "radius": "0.5rem",
  "logoPaths": {
    "dark": "src/assets/brand/wordmark-dark.svg"
  },
  "studio": {
    "accent": "#33503F",
    "chrome": "#2A4233",
    "fonts": {
      "display": "\"Fraunces Variable\", Georgia, \"Times New Roman\", serif",
      "body": "\"Source Sans 3 Variable\", system-ui, -apple-system, sans-serif"
    },
    "icons": {
      "tile": {
        "light": "#E9E1CC"
      },
      "types": {
        "aboutPage": "overview",
        "accessibilityPage": "help",
        "coursesPage": "scripture",
        "course": "scripture",
        "term": "times",
        "teachingArea": "category",
        "facultyPage": "people",
        "facultyMember": "person",
        "pricingPage": "give",
        "pricingTier": "give",
        "getStartedPage": "form",
        "forYouPage": "people",
        "resourcesPage": "download",
        "eventsPage": "event",
        "event": "event",
        "form": "form"
      },
      "groups": {
        "cover": "image",
        "schedule": "times",
        "thisTerm": "times",
        "pricing": "give",
        "pricingIntro": "give",
        "sections": "sections",
        "identity": "settings",
        "navigation": "link",
        "social": "link",
        "connect": "contact",
        "credentials": "person",
        "writing": "text",
        "details": "text",
        "fields": "form",
        "newsletter": "message"
      },
      "tools": {
        "term-setup": "times",
        "structure": "pages"
      }
    },
    "look": {
      "marker": {
        "src": "/studio-art/marker-cover.svg",
        "width": 41,
        "height": 34
      },
      "headingColor": "#222A25",
      "markColors": ["#33503F", "#7A2A2C", "#3E4F5C", "#222A25"],
      "stone": "square",
      "connector": {
        "kind": "dots",
        "color": "#C9A46A"
      },
      "tones": {
        "note": "#3E4F5C",
        "tip": "#C9A46A",
        "careful": "#7A2A2C"
      },
      "motif": "/studio-art/cover-shelf.svg",
      "motifNarrow": "/studio-art/cover-shelf-phone.svg",
      "texture": "/studio-art/texture-endpaper.svg",
      "edgeColors": [
        "#33503F",
        "#222A25",
        "#F7F1E1",
        "#7A2A2C",
        "#C9A46A",
        "#A9B9A7",
        "#3E4F5C",
        "#E4D3B4"
      ],
      "lettering": {
        "family": "PA Fraunces Italic",
        "src": "/studio-art/fraunces-italic-wght.woff2",
        "colors": ["#C7A875"]
      },
      "motion": "lay"
    }
  }
}
