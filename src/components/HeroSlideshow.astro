---
// Safe to edit by hand.
// Ken Burns hero slideshow. Renders a stack of cross-fading images with a slow,
// continuous zoom that pans from a different focal point on each slide (the
// "Ken Burns" effect). Driven entirely by CSS, so there is no JavaScript island
// and no layout shift: the frame reserves its aspect ratio and the images fade
// underneath it.
//
//   0 images  -> the empty "image well" placeholder
//   1 image   -> a single static image (no animation)
//   2+ images -> the cross-fading Ken Burns slideshow
//
// Timing and the multi-stop keyframe are generated from the image count so the
// hand-off stays clean for any number of slides. The first slide carries the
// alt text; the rest are decorative (they show the same subject matter and
// would only add noise for a screen reader). The whole effect is gated behind
// prefers-reduced-motion: visitors who ask for reduced motion get the first
// image as a still, with no fade and no zoom.

import SanityImage from '@/components/SanityImage.astro';
import { urlFor } from '@/lib/sanity';

interface Props {
  images?: any[];
  /** Tailwind aspect-ratio classes for the frame. */
  aspectClass?: string;
  /** Responsive sizes attribute passed to each image. */
  sizes?: string;
  /** Eager-load + high-priority the FIRST slide (use for an above-the-fold hero). */
  eager?: boolean;
  /** Max width requested from Sanity for each slide. */
  width?: number;
  /**
   * Height / width of the frame BELOW the lg breakpoint (the default
   * `aspect-[3/2]` frame is 2/3). The <img> is cropped to this ratio so a phone
   * downloads the pixels it shows; from lg up a <source> serves the 4:5 crop.
   * Keep it in step with the mobile half of `aspectClass`.
   */
  mobileRatio?: number;
  /** Unique id so multiple slideshows on one page don't share a keyframe name. */
  id?: string;
  class?: string;
}

const {
  images = [],
  aspectClass = 'aspect-[3/2] lg:aspect-[4/5]',
  sizes = '(min-width: 1024px) 520px, 90vw',
  eager = false,
  width = 1400,
  mobileRatio = 2 / 3,
  id = 'hero',
  class: extra = '',
} = Astro.props;

const slides = (images ?? []).filter((im) => im?.asset);
const n = slides.length;
const uid = `hkb-${id}`;

// Art direction (2026-10-13). The frame is 3:2 on phones and 4:5 from lg up, and
// each needs its own crop:
//   - lg and up: a <source> serves images already cropped to 4:5 (height =
//     width * 1.25). Otherwise Sanity serves wide variants whose HEIGHT is too
//     small for the tall portrait crop, and object-cover upscales them so they
//     look soft even from a high-res source.
//   - below lg: the <img> (SanityImage) is cropped to the 3:2 box. It used to
//     get the 4:5 crop too and object-cover trimmed it, so a 380px phone slot
//     downloaded 700x875 pixels to show 700x466 of them (Lighthouse flagged
//     167 KiB of that on the home page). The 3:2 crop frames from the hotspot
//     (or the centre) of the whole photo, so the phone view is a little wider
//     than the old middle-band-of-a-portrait crop.
const cropHeight = Math.round(width * 1.25);
const mobileHeight = Math.round(width * mobileRatio);

// Same width ladder as SanityImage (capped at `width`), at the 4:5 crop.
const DESKTOP_WIDTHS = [400, 600, 700, 800, 900, 1200, 1600, 2400].filter((w) => w <= width);
if (DESKTOP_WIDTHS[DESKTOP_WIDTHS.length - 1] !== width) DESKTOP_WIDTHS.push(width);
function desktopSrcset(img: any, quality: number): string {
  return DESKTOP_WIDTHS.map((w) => {
    const url = urlFor(img)
      .width(w)
      .height(Math.round(cropHeight * (w / width)))
      .quality(quality)
      .auto('format')
      .url();
    return `${url} ${w}w`;
  }).join(', ');
}

// Each image is the "front" image for ~7s; the loop is n * 7s long. Every image
// owns 100/n% of the timeline, with a short cross-fade overlapping into the next.
const SECONDS_PER = 7;
const total = Math.max(n, 1) * SECONDS_PER;
const seg = 100 / Math.max(n, 1);
const fade = Math.min(7, seg * 0.45);
const p1 = +fade.toFixed(2); // faded in
const p2 = +seg.toFixed(2); // hold ends, fade-out begins
const p3 = +(seg + fade).toFixed(2); // faded out
// Shift the whole sequence back by one fade so slide 1 is already fully visible
// at first paint (no blank flash on load) while the hand-off timing stays exact.
const shift = +((p1 / 100) * total).toFixed(2);
// A handful of transform-origins so each slide's zoom pans from a different spot.
const ORIGINS = ['50% 50%', '32% 30%', '68% 64%', '36% 68%', '66% 32%', '50% 38%'];

const css =
  n > 1
    ? `
@keyframes ${uid}-kb {
  0%      { opacity: 0; transform: scale(1.04); }
  ${p1}%  { opacity: 1; }
  ${p2}%  { opacity: 1; transform: scale(1.10); }
  ${p3}%  { opacity: 0; transform: scale(1.15); }
  100%    { opacity: 0; transform: scale(1.15); }
}
.${uid} .s { position: absolute; inset: 0; opacity: 0; will-change: opacity, transform; }
.${uid} .s:first-child { opacity: 1; }
@media (prefers-reduced-motion: no-preference) {
${slides
  .map(
    (_, i) =>
      `  .${uid} .s:nth-child(${i + 1}) { animation: ${uid}-kb ${total}s linear ${(i * SECONDS_PER - shift).toFixed(2)}s infinite; transform-origin: ${ORIGINS[i % ORIGINS.length]}; }`,
  )
  .join('\n')}
}
`
    : '';
---

{n === 0 ? (
  <div class={`relative ${aspectClass} overflow-hidden bg-muted ${extra}`}>
    <div class="image-well h-full w-full" />
  </div>
) : n === 1 ? (
  <div class={`relative ${aspectClass} overflow-hidden bg-muted ${extra}`}>
    <picture class="block h-full w-full">
      <source media="(min-width: 1024px)" srcset={desktopSrcset(slides[0], 65)} sizes={sizes} />
      <SanityImage
        source={slides[0]}
        width={width}
        height={mobileHeight}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        sizes={sizes}
        quality={65}
        class="h-full w-full object-cover"
      />
    </picture>
  </div>
) : (
  <div class={`${uid} relative ${aspectClass} overflow-hidden bg-muted ${extra}`}>
    {/* The eager first slide is the page's LCP, so it takes quality 60: the
          campus photos are high-detail (grass, foliage) and came out as a
          160KB AVIF at 72 on a 700px phone slot, which is the single biggest
          transfer on the mobile critical path. The later slides keep 72; they
          are deferred and download after the page has loaded. */}
    {slides.map((img, i) => (
      <div class="s" aria-hidden={i === 0 ? undefined : 'true'}>
        <picture class="block h-full w-full">
          <source
            media="(min-width: 1024px)"
            srcset={i > 0 ? undefined : desktopSrcset(img, eager ? 60 : 72)}
            sizes={i > 0 ? undefined : sizes}
            data-srcset={i > 0 ? desktopSrcset(img, 72) : undefined}
            data-sizes={i > 0 ? sizes : undefined}
          />
          <SanityImage
            source={img}
            width={width}
            height={mobileHeight}
            loading={eager && i === 0 ? 'eager' : 'lazy'}
            fetchpriority={eager && i === 0 ? 'high' : undefined}
            defer={i > 0}
            sizes={sizes}
            quality={eager && i === 0 ? 60 : 72}
            alt={i === 0 ? undefined : ''}
            class="h-full w-full object-cover"
          />
        </picture>
      </div>
    ))}
    <style is:inline set:html={css} />
  </div>
)}

<script>
  // Slides after the first render as blank placeholders (SanityImage `defer`)
  // and get their real URLs here, once the page has finished loading. Every
  // slide sits inside the hero box, so `loading="lazy"` never deferred them:
  // on the mobile Lighthouse run three ~80KB slides downloaded at high
  // priority next to the LCP image (2026-09-04). The first slide holds for
  // seven seconds, so a swap a moment after `load` is invisible to a visitor.
  // Astro bundles this once per page however many slideshows render, and the
  // astro:page-load hook covers View Transitions navigations.
  function hydrateSlides(): void {
    // The lg-and-up <source> goes first, so the <img> swap below picks it up.
    document.querySelectorAll<HTMLSourceElement>('source[data-srcset]').forEach((source) => {
      const { srcset, sizes } = source.dataset;
      if (sizes) source.sizes = sizes;
      if (srcset) source.srcset = srcset;
      delete source.dataset.srcset;
      delete source.dataset.sizes;
    });
    const imgs = document.querySelectorAll<HTMLImageElement>('img[data-srcset]');
    imgs.forEach((img) => {
      const { src, srcset, sizes } = img.dataset;
      if (sizes) img.sizes = sizes;
      if (srcset) img.srcset = srcset;
      if (src) img.src = src;
      img.setAttribute('fetchpriority', 'low');
      delete img.dataset.src;
      delete img.dataset.srcset;
      delete img.dataset.sizes;
    });
  }

  function afterLoad(): void {
    const go = (): void => {
      window.setTimeout(hydrateSlides, 800);
    };
    if (document.readyState === 'complete') go();
    else window.addEventListener('load', go, { once: true });
  }

  afterLoad();
  document.addEventListener('astro:page-load', afterLoad);
</script>
