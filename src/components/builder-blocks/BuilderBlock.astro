---
// Safe to edit by hand
// Picks the component for one builder-kit block (builderSections.ts, PORTS.md
// card 173). SectionRenderer hands every builder block here in one branch, so
// the kit grows without touching the shared renderer again. Every component is
// empty-safe: a block with nothing to show (a notice outside its dates, an event
// whose dates have all passed, a schedule with nothing in it) renders nothing.
//
// THE ACADEMY'S STYLES ARRIVE ONLY WITH A BLOCK (refoundation phase B,
// 2026-10-27). The starter imports its kit stylesheets here, which Astro then
// links from EVERY page that draws a SectionRenderer, used or not. On the
// Academy no live page holds a kit block yet, so those pages must not gain a
// stylesheet. `?inline` hands back the processed, minified CSS as a string
// without adding it to any page's bundle, and the first kit block a page draws
// writes it once as a <style> (the CSP allows inline styles). Order: the
// starter's two sheets, the shape classes (card 188, PORTABLE), then the
// Academy's scale and Rule & Ledger dress, which wins ties.
import kitCss from '@/styles/builder-blocks.css?inline';
import kitMoreCss from '@/styles/builder-blocks-more.css?inline';
import shapesCss from '@/styles/shapes.css?inline';
import academyCss from '@/styles/builder-blocks-academy.css?inline';
import type { BuilderPageBlock } from '@/lib/builderBlocks.types';
import type { CadenceSurface } from '@/lib/surfaces';
import ColumnsBlock from './ColumnsBlock.astro';
import ButtonRowBlock from './ButtonRowBlock.astro';
import PhotoBlock from './PhotoBlock.astro';
import AccordionBlock from './AccordionBlock.astro';
import TabsBlock from './TabsBlock.astro';
import CountdownBlock from './CountdownBlock.astro';
import NoticeBlock from './NoticeBlock.astro';
import TimelineBlock from './TimelineBlock.astro';
import LetterBlock from './LetterBlock.astro';
import EventDetailsBlock from './EventDetailsBlock.astro';
import ScheduleBlock from './ScheduleBlock.astro';
import PhotoCardsBlock from './PhotoCardsBlock.astro';
import ContactCardBlock from './ContactCardBlock.astro';
import HoursBlock from './HoursBlock.astro';
import MapBlock from './MapBlock.astro';
import CalendarSubscribeBlock from './CalendarSubscribeBlock.astro';
import IconCardsBlock from './IconCardsBlock.astro';
import StepsRailBlock from './StepsRailBlock.astro';
import HubBlock from './HubBlock.astro';

interface Props {
  block: BuilderPageBlock;
  /** The cadence's surface, including the band a look asked for. */
  surface?: CadenceSurface;
  headingId: string;
  /** The page's one accent button (card 158), when SectionRenderer hands it to this block. */
  primaryVariant?: 'primary' | 'secondary';
  /** True for the first section on the page: its photo loads first. */
  isFirst?: boolean;
}

const {
  block: b,
  surface = 'background',
  headingId,
  primaryVariant = 'secondary',
  isFirst = false,
} = Astro.props;
const common = { surface, headingId };

// Once per page: Astro.locals is a fresh object for every page render (static
// build and the SSR preview alike), so the first kit block claims the styles.
const locals = Astro.locals as { builderKitCss?: boolean };
const writeCss = !locals.builderKitCss;
locals.builderKitCss = true;
const KIT_STYLES = kitCss + kitMoreCss + shapesCss + academyCss;
---

{writeCss && <style is:inline set:html={KIT_STYLES} />}

{b._type === 'columnsSection' ? (
  <ColumnsBlock block={b} {...common} />
) : b._type === 'buttonRowSection' ? (
  <ButtonRowBlock block={b} {...common} />
) : b._type === 'photoSection' ? (
  <PhotoBlock block={b} {...common} isFirst={isFirst} />
) : b._type === 'accordionSection' ? (
  <AccordionBlock block={b} {...common} />
) : b._type === 'tabsSection' ? (
  <TabsBlock block={b} {...common} />
) : b._type === 'countdownSection' ? (
  <CountdownBlock block={b} {...common} />
) : b._type === 'noticeSection' ? (
  <NoticeBlock block={b} />
) : b._type === 'timelineSection' ? (
  <TimelineBlock block={b} {...common} />
) : b._type === 'letterSection' ? (
  <LetterBlock block={b} {...common} />
) : b._type === 'eventDetailsSection' ? (
  <EventDetailsBlock block={b} {...common} primaryVariant={primaryVariant} isFirst={isFirst} />
) : b._type === 'scheduleSection' ? (
  <ScheduleBlock block={b} {...common} />
) : b._type === 'photoCardsSection' ? (
  <PhotoCardsBlock block={b} {...common} isFirst={isFirst} />
) : b._type === 'hoursSection' ? (
  <HoursBlock block={b} {...common} />
) : b._type === 'mapSection' ? (
  <MapBlock block={b} {...common} />
) : b._type === 'contactCardSection' ? (
  <ContactCardBlock block={b} {...common} primaryVariant={primaryVariant} />
) : b._type === 'calendarSubscribeSection' ? (
  <CalendarSubscribeBlock block={b} {...common} />
) : b._type === 'iconCardsSection' ? (
  <IconCardsBlock block={b} {...common} isFirst={isFirst} />
) : b._type === 'stepsRailSection' ? (
  <StepsRailBlock block={b} {...common} primaryVariant={primaryVariant} />
) : b._type === 'hubSection' ? (
  <HubBlock block={b} {...common} isFirst={isFirst} />
) : null}
