---
// Foundation, edit with care
// =============================================================================
// ContactDetailsBlock — the Contact page's details + map (2026-08-26)
// =============================================================================
// Phase 2 of docs/superpowers/plans/2026-08-26-page-builder-conversion.md. The
// markup was CUT from contact.astro, not rewritten.
//
// Rendered OUTSIDE SectionShell (decision D1): fixed surface, no tone field.
//
// WHERE THE VALUES COME FROM
// Address, phone, email and office hours are SITE settings, not page content:
// they belong in one place and appear in the footer and the JSON-LD too. So the
// block resolves them itself through the same helper every other consumer uses,
// rather than taking them as fields an editor could let drift.
//
// TWO GUARDS THAT ARE TEST-GUARDED. Do not "simplify" them away:
//   1. The phone and email rows, and the "General questions" reason row, appear
//      only when those settings are set. They are '' until an editor fills them
//      in (the credential-less CI build renders exactly that state), and an <a>
//      with empty text is an axe link-name violation (tests/a11y.spec.ts).
//   2. `landmarkLabel` becomes this section's aria-label and must differ from
//      the page's h1, or axe flags two regions with the same accessible name.
import { getSiteSettings } from '@/lib/queries';
import { resolveSiteSettings } from '@/lib/siteSettings';
import { telHref } from '@/lib/phone';
import { MapPin, Phone, Mail, Clock } from 'lucide-react';

interface Props {
  block: any;
}
const { block } = Astro.props as Props;

const settings = resolveSiteSettings(await getSiteSettings().catch(() => null));

const addressLine = settings.addressLine;
const cityStateZip = settings.cityStateZip;
// The embedded map and the visible address read the same values on purpose.
const mapQuery = encodeURIComponent(`${addressLine}, ${cityStateZip}`);

// The who-to-reach rows are editable (the `reasons` field); this list renders
// when that field is empty, so the page is identical until an editor overrides
// it. The email row only exists when settings.email is set (guard 1 above).
const FALLBACK_REASONS = [
  ...(settings.email
    ? [{ label: 'General questions', value: settings.email, href: `mailto:${settings.email}` }]
    : []),
  { label: 'Courses and enrollment', value: 'Request information', href: '/get-started' },
  { label: 'Pricing and scholarships', value: 'See pricing', href: '/pricing' },
];

const reasons = block?.reasons?.length ? block.reasons : FALLBACK_REASONS;
---

<section class="bg-background" aria-label={block?.landmarkLabel ?? 'Contact details'}>
  <div
    class="mx-auto grid max-w-content grid-cols-1 items-start gap-l px-m py-section-lg lg:grid-cols-2 lg:gap-section-md"
  >
    {/* Details */}
    <div class="space-y-l">
      <ul class="list-none space-y-m p-0 text-lg">
        <li class="flex items-start gap-s">
          <MapPin size={20} aria-hidden="true" className="mt-1 shrink-0 text-primary" />
          <span>{addressLine}<br />{cityStateZip}</span>
        </li>
        {
          settings.phone && (
            <li class="flex items-start gap-s">
              <Phone size={20} aria-hidden="true" className="mt-1 shrink-0 text-primary" />
              <a
                href={telHref(settings.phone)}
                class="text-link underline underline-offset-2 transition-colors hover:text-primary-dark"
              >
                {settings.phone}
              </a>
            </li>
          )
        }
        {
          settings.email && (
            <li class="flex items-start gap-s">
              <Mail size={20} aria-hidden="true" className="mt-1 shrink-0 text-primary" />
              <a
                href={`mailto:${settings.email}`}
                class="break-all text-link underline underline-offset-2 transition-colors hover:text-primary-dark"
              >
                {settings.email}
              </a>
            </li>
          )
        }
        <li class="flex items-start gap-s">
          <Clock size={20} aria-hidden="true" className="mt-1 shrink-0 text-primary" />
          <span>Office hours: {settings.officeHours}</span>
        </li>
      </ul>

      <div class="border-t border-border-soft pt-l">
        <p class="eyebrow mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">
          {block?.whoToReachLabel ?? 'Who to reach'}
        </p>
        <ul class="list-none space-y-2 p-0">
          {
            reasons.map((r: any) => (
              <li class="flex flex-wrap justify-between gap-m border-b border-border-soft pb-2 last:border-b-0">
                <span class="text-foreground">{r.label}</span>
                <a
                  href={r.href}
                  class="break-all text-link underline underline-offset-2 transition-colors hover:text-primary-dark"
                >
                  {r.value}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="border-t border-border-soft pt-l leading-relaxed text-foreground/80">
        <p class="eyebrow mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">
          {block?.gettingHereLabel ?? 'Getting here'}
        </p>
        <p>
          {
            block?.gettingHereBody ??
              'Courses meet in person on the West Chester campus, with free on-site parking. The building is a short drive from the interstate.'
          }
        </p>
      </div>
    </div>

    {/* Map */}
    <div class="h-full min-h-[320px] overflow-hidden rounded-md border border-border-soft">
      <iframe
        title={block?.mapTitle ?? 'Map to The Presbyterian Academy'}
        src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
        width="100%"
        height="100%"
        style="min-height: 360px; border: 0;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>
