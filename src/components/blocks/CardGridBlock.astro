---
// Card grid block. Inner content only; SectionShell provides the background.
// Section heading inherits the tone color; cards are light surfaces with dark text.
// Appearance controls (2026-08-28): an optional accent word in the heading, and
// the subhead's optional rich twin (bold / italic). Both are absent by default,
// and both fall through to the exact markup this block rendered before.
import InlineRich from '@/components/InlineRich.astro';
import { hasInlineRich } from '@/lib/inline-rich';
import { splitHeadingAccent } from '@/lib/heading-accent';
// Wave 3 (2026-08-28): the column classes moved to src/lib/layout-variants.ts,
// which holds this block's map verbatim. Same strings, one place.
import { columnsClass } from '@/lib/layout-variants';

const { block } = Astro.props as { block: any };
const cards = block?.cards ?? [];
const ha = splitHeadingAccent(block?.heading, block?.headingAccent);
const richSubhead = hasInlineRich(block?.subheadRich);
const colClass = columnsClass('sectionCardGrid', block?.columns);
---

{
  block && cards.length > 0 && (
    <div class="mx-auto max-w-content px-m">
      {(block.eyebrow || block.heading || block.subhead || richSubhead) && (
        <div class="max-w-2xl">
          {block.eyebrow && <p class="text-xs uppercase tracking-eyebrow opacity-70">{block.eyebrow}</p>}
          {block.heading && (
            <h2 class="mt-s font-display text-h2">
              {ha.found ? (
                <Fragment>{ha.before}<span class="heading-accent">{ha.word}</span>{ha.after}</Fragment>
              ) : (
                block.heading
              )}
            </h2>
          )}
          {richSubhead ? (
            <p class="mt-s opacity-80 leading-relaxed"><InlineRich value={block.subheadRich} /></p>
          ) : (
            block.subhead && <p class="mt-s opacity-80 leading-relaxed">{block.subhead}</p>
          )}
        </div>
      )}
      <div class={`mt-l grid grid-cols-1 ${colClass} gap-m`} data-stagger-grid>
        {cards.map((c: any) => {
          const inner = (
            <Fragment>
              <span class="block h-1.5 w-10 rounded-t-full bg-gold/70 mb-m" aria-hidden="true" />
              <h3 class="font-display text-h4 text-foreground">{c.title}</h3>
              {c.body && <p class="mt-s text-foreground/80 leading-relaxed">{c.body}</p>}
            </Fragment>
          );
          return c.link ? (
            <a href={c.link} class="card-lift group block rounded-lg border border-border-soft bg-card p-l no-underline">
              {inner}
            </a>
          ) : (
            <div class="rounded-lg border border-border-soft bg-card p-l">{inner}</div>
          );
        })}
      </div>
    </div>
  )
}
