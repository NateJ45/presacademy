---
// Foundation, edit with care
// =============================================================================
// NumberedCardsBlock — the 01/02/03 ledger cards (2026-08-26)
// =============================================================================
// Phase 1 + Phase 2 of docs/superpowers/plans/2026-08-26-page-builder-conversion.md.
// Every branch below was CUT from the page that owns it, not rewritten:
//   top2 / full  for-you.astro's personas
//   ledger       about.astro's "What we believe"
//   steps        get-started.astro's "What happens next"
//
// Rendered OUTSIDE SectionShell (decision D1): the surfaces are fixed in code
// and there is no tone field.
//
// WHY THERE ARE THREE MARKUP BRANCHES AND NOT ONE
// Phase 1 assumed the four pages differed by border alone. They do not: the
// warm bands differ in surface, vertical rhythm, column count, heading size,
// number size and header shape as well. One averaged band would have been a
// visual change on three live pages, which is the one thing this conversion
// promises never to do. So `variant` picks a whole treatment, each held to its
// source page by the parity harness.
//
// PROVEN: top2 (for-you), ledger (about), steps (get-started), all 2026-08-26.
// DECLARED, NOT PROVEN: full. It is the boxed band with gold on all four sides,
// waiting for a page that wants it. Verify with the harness before trusting it.
//
// HEADING LEVELS
// The cards' titles are h2 when the section carries no heading of its own (they
// are then the top-level headings of that band, which is how For You reads
// today) and h3 when it does, so the section never skips a level. The warm
// bands always render h3 titles, matching their source pages. That keeps the
// Studio Checkup's "page body starts at h2, no skipped levels" rule satisfied
// whichever way an editor fills the section in.
import CtaLink from '@/components/CtaLink.astro';

interface Props {
  block: any;
}
const { block } = Astro.props as Props;

const cards = block?.cards ?? [];
const heading = block?.heading;
const hasHeader = Boolean(block?.eyebrow || heading || block?.intro);

// Only label the landmark when there IS a heading to label it with: the pages
// that carry a bare grid of cards render a plain <section>, and adding an
// aria-labelledby pointing at nothing would be worse than nothing.
const headingId = hasHeader && heading ? (block?.headingId || undefined) : undefined;

// See the heading-levels note above.
const CardHeading = heading ? 'h3' : 'h2';

// The two boxed border treatments. `top2` is parity-proven; see the header.
const BORDERS: Record<string, string> = {
  top2: 'list-none border border-t-2 border-border-soft border-t-gold p-l',
  full: 'list-none border border-t-2 border-gold p-l',
};
const variant = block?.variant as string;
const cardClass = BORDERS[variant] ?? BORDERS.top2;

// The two-digit ledger number, the one thing every branch shares.
const num = (i: number) => String(i + 1).padStart(2, '0');
---

{
  cards.length > 0 && (
    variant === 'ledger' ? (
      /* About: "What we believe". Warm surface, a gold rule under the header,
         two columns of unboxed cards, a quiet footnote. */
      <section class="surface-warm bg-muted" aria-labelledby={headingId}>
        <div class="mx-auto max-w-content px-m py-section-lg">
          <div data-reveal>
            {block.eyebrow && (
              <p class="eyebrow text-xs uppercase tracking-eyebrow text-foreground/80">{block.eyebrow}</p>
            )}
            {heading && (
              <h2 id={headingId} class="mt-2 max-w-3xl font-display text-h2 text-foreground">{heading}</h2>
            )}
          </div>
          <div class="mt-l h-px w-full bg-gold/50" />
          <div class="mt-l grid grid-cols-1 gap-l md:grid-cols-2" data-stagger-grid>
            {cards.map((c: any, i: number) => (
              <div class="border-t-2 border-gold pt-4">
                <span class="font-display text-sm tabular-nums tracking-[0.12em] text-gold-ink">{num(i)}</span>
                <h3 class="mt-2 font-display text-h4 text-foreground">{c.title}</h3>
                <p class="mt-2 leading-relaxed text-foreground/80">{c.body}</p>
              </div>
            ))}
          </div>
          {block?.footnote && <p class="mt-l max-w-2xl text-foreground/70">{block.footnote}</p>}
        </div>
      </section>
    ) : variant === 'steps' ? (
      /* Get Started: "What happens next". The same warm surface, one step
         quieter: eyebrow only, three columns, smaller type throughout. */
      <section class="surface-warm bg-muted">
        <div class="mx-auto max-w-content px-m py-section-md">
          <div data-reveal>
            {block.eyebrow && (
              <p class="eyebrow text-xs uppercase tracking-eyebrow text-foreground/80">{block.eyebrow}</p>
            )}
          </div>
          <div class="mt-l grid grid-cols-1 gap-l md:grid-cols-3" data-stagger-grid>
            {cards.map((c: any, i: number) => (
              <div class="border-t-2 border-gold pt-4">
                <span class="font-display text-lg tabular-nums text-gold-ink">{num(i)}</span>
                <h3 class="mt-2 font-display text-h5 text-foreground">{c.title}</h3>
                {c.body && <p class="mt-1 text-sm text-foreground/75">{c.body}</p>}
              </div>
            ))}
          </div>
        </div>
      </section>
    ) : (
      /* For You: boxed cards on paper, each with an optional button. */
      <section class="bg-background" aria-labelledby={headingId}>
        <div class="mx-auto max-w-content px-m pb-section-lg">
          {hasHeader && (
            <div class="mb-l" data-reveal>
              {block.eyebrow && (
                <p class="eyebrow text-xs uppercase tracking-eyebrow text-foreground/80">{block.eyebrow}</p>
              )}
              {heading && (
                <h2 id={headingId} class="mt-2 max-w-3xl font-display text-h2 text-foreground">{heading}</h2>
              )}
              {block.intro && <p class="mt-m max-w-2xl text-foreground/80">{block.intro}</p>}
            </div>
          )}
          <ul class="grid grid-cols-1 gap-l md:grid-cols-2" data-stagger-grid>
            {cards.map((c: any, i: number) => (
              <li class={cardClass}>
                <span class="font-display text-sm tabular-nums tracking-[0.12em] text-gold-ink">{num(i)}</span>
                <CardHeading class="mt-2 font-display text-h3 text-foreground">{c.title}</CardHeading>
                {c.body && <p class="mt-2 text-foreground/80">{c.body}</p>}
                {c.cta && (
                  <div class="mt-m">
                    <CtaLink cta={c.cta} variant="secondary" fallbackHref="/get-started" fallbackLabel="Learn more" />
                  </div>
                )}
              </li>
            ))}
          </ul>
          {block?.footnote && <p class="mt-l max-w-2xl text-foreground/70">{block.footnote}</p>}
        </div>
      </section>
    )
  )
}
