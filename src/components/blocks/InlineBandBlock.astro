---
// Foundation, edit with care
// =============================================================================
// InlineBandBlock — the thin signpost strip (2026-08-26)
// =============================================================================
// Phase 2 of docs/superpowers/plans/2026-08-26-page-builder-conversion.md. The
// markup was CUT from about.astro's faculty band, not rewritten.
//
// Rendered OUTSIDE SectionShell (decision D1): fixed surface, no tone field.
//
// The button is hand-written markup rather than <CtaLink>, because the band's
// pill is the page's own and CtaLink renders a different element. That is why
// the schema takes a plain label + URL here instead of the shared ctaBlock.
import { pillClasses, type PillVariant } from '@/lib/pill-variant';

interface Props {
  block: any;
  /** The page's accent budget (SectionRenderer, src/lib/pill-variant.ts). */
  primaryVariant?: PillVariant;
}
const { block, primaryVariant } = Astro.props as Props;

const href = block?.ctaUrl || '/faculty/';
const pill = pillClasses(
  'press-tactile inline-flex min-h-[44px] items-center rounded-full bg-primary px-l py-s text-xs font-semibold tracking-[0.18em] text-primary-foreground uppercase hover:bg-primary-dark',
  primaryVariant,
);
---

{block?.headline && (
  <section class="border-y border-border-soft bg-background">
    <div class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-m px-m py-l">
      <div>
        {block.eyebrow && (
          <p class="eyebrow text-xs tracking-eyebrow text-foreground/80 uppercase">
            {block.eyebrow}
          </p>
        )}
        <p class="mt-2 max-w-xl font-display text-h4 text-foreground">{block.headline}</p>
      </div>
      <a href={href} class={pill}>
        {block.ctaLabel}
      </a>
    </div>
  </section>
)}
