---
// Numbered steps ("plan a visit" 1-2-3). Tone-adaptive: text inherits the
// SectionShell color; the number badge uses the gold accent.
// The intro's optional rich twin (bold / italic), 2026-08-28. Absent, the
// markup is exactly what it was.
import InlineRich from '@/components/InlineRich.astro';
import { hasInlineRich } from '@/lib/inline-rich';
// Wave 3 (2026-08-28): the three-across grid became an editor choice of two or
// three. Three is the default and emits the exact string that was inline here,
// so every published steps section is unchanged.
import { columnsClass } from '@/lib/layout-variants';

const { block } = Astro.props as { block: any };
const steps = block?.steps ?? [];
const richIntro = hasInlineRich(block?.introRich);
const colClass = columnsClass('sectionSteps', block?.columns);
---

{
  block && steps.length > 0 && (
    <div class="mx-auto max-w-content px-m">
      {(block.eyebrow || block.heading || block.intro || richIntro) && (
        <div class="max-w-2xl mb-l">
          {block.eyebrow && <p class="text-xs uppercase tracking-eyebrow opacity-70">{block.eyebrow}</p>}
          {block.heading && <h2 class="mt-s font-display text-h2">{block.heading}</h2>}
          {richIntro ? (
            <p class="mt-s opacity-80 leading-relaxed"><InlineRich value={block.introRich} /></p>
          ) : (
            block.intro && <p class="mt-s opacity-80 leading-relaxed">{block.intro}</p>
          )}
        </div>
      )}
      <ol class={`grid grid-cols-1 ${colClass} gap-l list-none p-0 counter-reset`} data-stagger-grid>
        {steps.map((s: any, i: number) => (
          <li class="flex gap-m">
            <span
              class="shrink-0 inline-flex h-10 w-10 items-center justify-center rounded-full border border-gold/60 text-gold-ink font-display text-h4"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <div>
              <h3 class="font-display text-h4">{s.title}</h3>
              {s.body && <p class="mt-xs opacity-80 leading-relaxed">{s.body}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  )
}
