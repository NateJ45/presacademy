---
// Stats / numbers block. Big values + labels, sitting directly on the section
// background, so all text inherits the SectionShell tone color (reads on paper,
// chapel green, or over media).
// Wave 3 (2026-08-28): the column classes moved to src/lib/layout-variants.ts,
// which holds this block's map verbatim. Same strings, one place.
import { columnsClass } from '@/lib/layout-variants';

const { block } = Astro.props as { block: any };
const items = block?.items ?? [];
const colClass = columnsClass('sectionStats', block?.columns);
---

{
  block && items.length > 0 && (
    <div class="mx-auto max-w-content px-m">
      {(block.eyebrow || block.heading || block.intro) && (
        <div class="mb-l max-w-2xl">
          {block.eyebrow && (
            <p class="text-xs tracking-eyebrow uppercase opacity-70">{block.eyebrow}</p>
          )}
          {block.heading && <h2 class="mt-s font-display text-h2">{block.heading}</h2>}
          {block.intro && <p class="mt-s leading-relaxed opacity-80">{block.intro}</p>}
        </div>
      )}
      <div class={`grid grid-cols-2 ${colClass} gap-l text-center`} data-stagger-grid>
        {items.map((s: any) => (
          <div>
            <p class="font-display text-h1 leading-none">{s.value}</p>
            <p class="mt-s text-xs tracking-eyebrow uppercase opacity-80">{s.label}</p>
            {s.note && <p class="mt-xs text-sm leading-relaxed opacity-60">{s.note}</p>}
          </div>
        ))}
      </div>
    </div>
  )
}
