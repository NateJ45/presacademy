---
// Foundation, edit with care
// =============================================================================
// RequestPanelBlock — Get Started's form + intro-call panel (2026-08-26)
// =============================================================================
// Phase 2 of docs/superpowers/plans/2026-08-26-page-builder-conversion.md. The
// markup was CUT from get-started.astro, not rewritten.
//
// Rendered OUTSIDE SectionShell (decision D1): fixed surface, no tone field.
//
// THE THREE FALLBACKS IN THE ASIDE, IN ORDER. All three ship together and none
// is decorative:
//   1. The block's own `calendlyUrl` field, so an editor can change the booking
//      link without a deploy.
//   2. PUBLIC_CALENDLY_URL from the build environment, which is where the link
//      lived before the field existed.
//   3. No link at all: the button becomes "Email to set up an intro", a mailto
//      to the site's contact address. That is the state the credential-less CI
//      build renders, and it must stay a real, labeled link (an <a> with empty
//      text is an axe link-name violation).
//
// The form itself is rendered by the shared FormBlock, so the native/embed
// modes and the hCaptcha wiring are not forked here either.
import FormBlock from '@/components/FormBlock.astro';

interface Props {
  block: any;
  /** Contact email from siteSettings, passed down by Sections.astro. */
  fallbackEmail?: string;
}
const { block, fallbackEmail } = Astro.props as Props;

const calendlyUrl = block?.calendlyUrl ?? import.meta.env.PUBLIC_CALENDLY_URL ?? '';

const pillPrimary =
  'press-tactile inline-flex items-center justify-center min-h-[44px] w-full px-l py-s rounded-full text-xs font-semibold uppercase tracking-[0.18em] bg-primary text-primary-foreground hover:bg-primary-dark transition-colors';
---

<section class="bg-background">
  <div class="mx-auto grid max-w-content grid-cols-1 gap-x-12 gap-y-l px-m pb-section-lg lg:grid-cols-[1.1fr_.9fr]">
    {/* Express-interest form */}
    <div>
      <div data-reveal>
        <p class="eyebrow text-xs uppercase tracking-eyebrow text-gold-ink">{block?.requestEyebrow}</p>
        <h2 class="mt-2 font-display text-h3 text-foreground">{block?.requestHeadline}</h2>
        <p class="mt-3 text-foreground/80">{block?.requestBody}</p>
      </div>
      <div class="mt-l">
        <FormBlock form={block?.form} fallbackEmail={fallbackEmail} fallbackLabel="Email us" />
      </div>
    </div>

    {/* Ruled panel: free intro + visit + syllabus */}
    <aside>
      <div class="h-0.5 w-full bg-gold"></div>
      <div class="border border-t-0 border-border-soft bg-card p-l">
        <p class="eyebrow text-xs uppercase tracking-eyebrow text-foreground/80">{block?.calendlyEyebrow}</p>
        <h3 class="mt-2 font-display text-h4 text-foreground">{block?.calendlyHeadline}</h3>
        <p class="mt-2 text-sm text-foreground/75">{block?.calendlyBody}</p>
        {calendlyUrl ? (
          <a href={calendlyUrl} target="_blank" rel="noopener noreferrer" class={`${pillPrimary} mt-m`}>Book a free intro</a>
        ) : (
          <a href={`mailto:${fallbackEmail}`} class={`${pillPrimary} mt-m`}>Email to set up an intro</a>
        )}

        <div class="mt-l border-t border-border-soft pt-l">
          <p class="eyebrow text-xs uppercase tracking-eyebrow text-foreground/80">Visit a class</p>
          <p class="mt-2 text-sm text-foreground/75">{block?.visitClassBody}</p>
        </div>

        <div class="mt-l border-t border-border-soft pt-l">
          <p class="eyebrow text-xs uppercase tracking-eyebrow text-foreground/80">Take a syllabus with you</p>
          <p class="mt-2 text-sm text-foreground/75">{block?.syllabusBody}</p>
          <a href="/courses" class="mt-2 inline-block text-sm text-link underline underline-offset-2 hover:text-primary-dark">Browse courses</a>
        </div>
      </div>
    </aside>
  </div>
</section>
