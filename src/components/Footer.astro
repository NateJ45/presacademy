---
// Foundation, edit with care
// =============================================================================
// The back cover (the 2026-10-13 chrome redesign). The footer reads like the
// back of the term's issue, on the deepest green in both themes:
//
//   ▓▓▓▓▓▓▓▓  spine strip (the eight cover colours, as on the masthead)
//   [newsletter sign-up, only when Site Settings -> Newsletter is on]
//   COLOPHON                    INDEX                 IN THIS ISSUE
//   The Presbyterian Academy    A About               [cover] Spring 2027
//   mission. Published each       Accessibility               Eight courses, ...
//   term in ..., made possible  C Contact                     Browse the issue ->
//   by the {funder}.              Courses             ( REQUEST INFORMATION )
//   WHERE  address · Directions   ...
//   OFFICE hours
//   WRITE  email
//   ─────────────────────────────────────────────────────────────────────
//   © 2026 THE PRESBYTERIAN ACADEMY · SET IN ...      DESIGNED BY ...
//
// Phones stack it Colophon, In this issue, Index (CSS `order`; the DOM keeps
// the desktop order). The INDEX is every footer link once, A to Z, with a small
// initial at each new letter (src/lib/chrome.ts buildIndex). It flows in two
// CSS COLUMNS, not a row-wise grid, so the DOM order (and what a screen reader
// hears) stays alphabetical while the eye reads down each column.
//
// Content: identity, contact and the index links from siteSettings through
// resolveSiteSettings; the issue and its cover from getChromeData. Empty values
// hide their row rather than show a stand-in. The type credit is code-owned on
// purpose: it names the fonts this code loads.
// =============================================================================

import { resolveSiteSettings, type RawSiteSettings } from '@/lib/siteSettings';
import { site } from '@/data/site';
import { getChromeData } from '@/lib/queries';
import { buildIndex, issueSummary, orderShelf } from '@/lib/chrome';
import { COVER_COLORS, coverStyle, resolveCover } from '@/lib/cover';
import NewsletterSignup from '@/components/NewsletterSignup';
import { telHref } from '@/lib/phone';
import { issueLine } from '@/lib/term-issue';
import { withTrailingSlash } from '@/lib/href';
import ActionBar from '@/components/ActionBar.astro';

interface NewsletterConfig {
  enabled?: boolean;
  heading?: string;
  blurb?: string;
  buttonLabel?: string;
  successMessage?: string;
  consentNote?: string;
  formActionUrl?: string | null;
  audienceId?: string | null;
}

interface Props {
  siteSettings?:
    | (RawSiteSettings & {
        funder?: string;
        footerCredit?: string;
        footerCreditUrl?: string;
        newsletter?: NewsletterConfig | null;
      })
    | null;
}

const { siteSettings } = Astro.props as Props;

const settings = resolveSiteSettings(siteSettings);
const brandName = settings.brandName;
const email = settings.email;
const phone = settings.phone;
const officeHours = settings.officeHours;
const plateLead = site.wordmark.line1;
const plateKey = site.wordmark.line2;

// The colophon paragraph: the mission, then where the issue is "published" and
// who makes it possible (siteSettings.funder; clearing it drops that clause).
const funder = siteSettings?.funder ?? 'Presbytery of Cincinnati';
const place = [settings.addressLocality, settings.addressRegion].filter(Boolean).join(', ');
const imprint = [
  place ? `Published each term in ${place}` : 'Published each term',
  funder ? `made possible by the ${funder}` : '',
]
  .filter(Boolean)
  .join(', and ');
const colophon = `${settings.mission} ${imprint}.`;

// Socials, when any are set and the footer switch is on: one quiet row.
const socials = settings.showFooterSocials
  ? [
      { label: 'Instagram', href: settings.social.instagram },
      { label: 'Facebook', href: settings.social.facebook },
      { label: 'YouTube', href: settings.social.youtube },
    ].filter((s): s is { label: string; href: string } => Boolean(s.href))
  : [];

// The index: every footer column link plus the extra (small-print) links, once
// each, A to Z.
const index = buildIndex([
  ...settings.footerColumns.flatMap((col) => col.links),
  ...settings.legalNav,
]);

// In this issue: the next term, its lead cover, and one line about it.
const chrome = await getChromeData();
const termTitle = (chrome.term?.title ?? '').trim();
const lead = orderShelf(chrome.courses, 1)[0];
const leadCover = lead
  ? resolveCover(lead)
  : { color: 'green' as const, ornament: 'circle' as const };
const summary = issueSummary(chrome.courseCount, chrome.term?.startDate);
const headerCta = settings.headerCta;

// The phone action bar (starter card 191): the masthead's phone issue line and the header button,
// docked once the page heading scrolls away. Not on the page the button opens (the preview's
// /preview prefix is dropped first, so the draft preview behaves the same).
const herePath = withTrailingSlash(Astro.url.pathname.replace(/^\/preview(?=\/|$)/, '') || '/');
const barHref = headerCta.show ? headerCta.href : '';
const showActionBar =
  !!barHref && !!headerCta.label && withTrailingSlash(barHref.split('#')[0]) !== herePath;
const barLine = issueLine(chrome.term, new Date().toISOString().slice(0, 10))?.short ?? '';

const currentYear = new Date().getFullYear();
// Designer credit: always shown; editable in Site Settings.
const creditLabel = siteSettings?.footerCredit ?? 'Designed by Nixon Creative Studio';
const creditUrl = siteSettings?.footerCreditUrl ?? 'https://www.nixoncreativestudio.com';
---

<footer class="back-cover bg-chapel-deep text-chapel-foreground">
  <div class="spine spine--footer" aria-hidden="true">
    {COVER_COLORS.map((c) => (
      <span style={`background: var(--color-cover-${c})`} />
    ))}
  </div>

  {/* Newsletter sign-up: renders only when siteSettings.newsletter.enabled. */}
  {siteSettings?.newsletter?.enabled && (
    <div class="mx-auto max-w-content px-4 pt-12 sm:px-6 lg:px-12">
      <div class="mx-auto max-w-md">
        <NewsletterSignup client:visible newsletter={siteSettings.newsletter} source="footer" />
      </div>
    </div>
  )}

  <div class="back-cover__grid mx-auto max-w-content px-4 pt-12 sm:px-6 lg:px-12 lg:pt-[72px]">
    {/* ---- Colophon ---------------------------------------------------- */}
    <section class="back-cover__colophon" aria-labelledby="bc-colophon">
      <h2 id="bc-colophon" class="back-cover__kicker">
        Colophon
      </h2>
      <a href="/" class="back-cover__plate">
        {plateLead}
        {plateKey && (
          <>
            {' '}
            <i>{plateKey}</i>
          </>
        )}
        <span class="sr-only"> home</span>
      </a>
      <p class="back-cover__lede">{colophon}</p>
      <dl class="back-cover__facts">
        {settings.fullAddress && (
          <>
            <dt>Where</dt>
            <dd>
              {settings.fullAddress}
              <span class="hidden lg:inline" aria-hidden="true">
                {' '}
                ·{' '}
              </span>
              <a
                href={settings.mapHref}
                target="_blank"
                rel="noopener noreferrer"
                class="back-cover__directions"
              >
                Directions
                <span class="lg:hidden" aria-hidden="true">
                  {' '}
                  &rarr;
                </span>
              </a>
            </dd>
          </>
        )}
        {officeHours && (
          <>
            <dt>Office</dt>
            <dd>{officeHours}</dd>
          </>
        )}
        {(email || phone) && (
          <>
            <dt>Write</dt>
            <dd class="flex flex-col items-start">
              {email && (
                <a href={`mailto:${email}`} class="back-cover__link">
                  {email}
                </a>
              )}
              {phone && (
                <a href={telHref(phone)} class="back-cover__link">
                  {phone}
                </a>
              )}
            </dd>
          </>
        )}
        {socials.length > 0 && (
          <>
            <dt>Follow</dt>
            <dd class="flex flex-wrap gap-x-4">
              {socials.map((s) => (
                <a href={s.href} target="_blank" rel="noopener noreferrer" class="back-cover__link">
                  {s.label}
                </a>
              ))}
            </dd>
          </>
        )}
      </dl>
    </section>

    {/* ---- Index ------------------------------------------------------- */}
    <nav class="back-cover__index" aria-labelledby="bc-index">
      <h2 id="bc-index" class="back-cover__kicker">
        Index
      </h2>
      <ul class="index-list">
        {index.map((entry) => (
          <li class="index-list__item">
            <span class="index-list__initial" aria-hidden="true">
              {entry.initial ?? ''}
            </span>
            <a
              href={entry.href}
              class="index-list__link"
              {...(entry.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {entry.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* ---- In this issue ----------------------------------------------- */}
    <section class="back-cover__issue" aria-labelledby="bc-issue">
      <h2 id="bc-issue" class="back-cover__kicker">
        In this issue
      </h2>
      <a href="/courses/" class="back-cover__issue-link group">
        <span
          class:list={['mini-cover mini-cover--issue', !lead && 'mini-cover--plain']}
          style={coverStyle(leadCover.color)}
          aria-hidden="true"
        >
          {lead?.courseCode && <span class="mini-cover__code">{lead.courseCode}</span>}
          <span class="cover__orn" data-ornament={leadCover.ornament} />
          {lead?.title && <span class="mini-cover__title">{lead.title}</span>}
        </span>
        <span class="flex flex-col gap-1">
          <span class="font-display text-[21px] leading-[1.1] text-chapel-foreground lg:text-[22px]">
            {termTitle || 'The course catalog'}
          </span>
          {summary && <span class="text-[14.5px] text-chapel-foreground/80">{summary}</span>}
          <span class="mt-1 text-[15px] font-semibold">
            Browse the issue <span aria-hidden="true">&rarr;</span>
          </span>
        </span>
      </a>
      {headerCta.show && (
        <a href={headerCta.href} class="back-cover__cta press-tactile">
          {headerCta.label}
        </a>
      )}
    </section>
  </div>

  {/* ---- Bottom line, in mono ------------------------------------------ */}
  <div class="mx-auto mt-10 max-w-content px-4 sm:px-6 lg:mt-16 lg:px-12">
    <div class="back-cover__base">
      <p class="flex flex-col gap-2 lg:block">
        <span>
          © {currentYear} {brandName}
        </span>
        <span class="hidden lg:inline" aria-hidden="true">
          {' '}
          ·{' '}
        </span>
        <span>Set in Fraunces, Source Sans and IBM Plex Mono</span>
      </p>
      {creditUrl ? (
        <a href={creditUrl} target="_blank" rel="noopener noreferrer" class="back-cover__credit">
          {creditLabel}
        </a>
      ) : (
        <span>{creditLabel}</span>
      )}
    </div>
  </div>

  {showActionBar && <ActionBar text={barLine} label={headerCta.label} href={barHref} />}
</footer>
