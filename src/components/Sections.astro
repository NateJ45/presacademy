---
// Page-builder renderer. Maps each flexibleSections block (_type) to its
// on-brand component. Unknown types are skipped. Used by the generic `page`
// type at /[slug] and any page that adds a flexibleSections[] field.
//
// Shell-aware blocks (the newer, tone-adaptive ones) render their inner content
// only and are wrapped in <SectionShell> so a single editor control sets their
// background (token tone, or image/video with overlay). The original blocks
// render their own section background and are passed through unwrapped.
import SectionShell from '@/components/SectionShell.astro';
import SectionCoach from '@/components/SectionCoach.astro';
import { sectionEditAttr, type EditDoc } from '@/lib/preview-edit-attr';
import { sectionCoach } from '@/lib/section-coach';
import RichTextBlock from '@/components/blocks/RichTextBlock.astro';
import ImageTextBlock from '@/components/blocks/ImageTextBlock.astro';
import CardGridBlock from '@/components/blocks/CardGridBlock.astro';
import QuoteBlock from '@/components/blocks/QuoteBlock.astro';
import CtaBandBlock from '@/components/blocks/CtaBandBlock.astro';
import FormRefBlock from '@/components/blocks/FormRefBlock.astro';
import FeatureCardsBlock from '@/components/blocks/FeatureCardsBlock.astro';
import StatsBlock from '@/components/blocks/StatsBlock.astro';
import AccordionBlock from '@/components/blocks/AccordionBlock.astro';
import GalleryBlock from '@/components/blocks/GalleryBlock.astro';
import StepsBlock from '@/components/blocks/StepsBlock.astro';
import LogosBlock from '@/components/blocks/LogosBlock.astro';
import MediaFeatureBlock from '@/components/blocks/MediaFeatureBlock.astro';
import DynamicListBlock from '@/components/blocks/DynamicListBlock.astro';
import MediaShowcaseBlock from '@/components/blocks/MediaShowcaseBlock.astro';
import FaqListBlock from '@/components/blocks/FaqListBlock.astro';
import ResourcesBlock from '@/components/blocks/ResourcesBlock.astro';
import KeyDatesBlock from '@/components/blocks/KeyDatesBlock.astro';
import PricingTiersBlock from '@/components/blocks/PricingTiersBlock.astro';
import EmbedBlock from '@/components/EmbedBlock.astro';
// Ported page sections (Rule & Ledger), 2026-08-26. These render their own
// fixed surfaces and stay OUT of SHELL_AWARE on purpose (decision D1).
import LegalBodyBlock from '@/components/blocks/LegalBodyBlock.astro';
import NumberedCardsBlock from '@/components/blocks/NumberedCardsBlock.astro';
import ScholarshipBlock from '@/components/blocks/ScholarshipBlock.astro';
import LedgerStatsBlock from '@/components/blocks/LedgerStatsBlock.astro';
import EditorialColumnsBlock from '@/components/blocks/EditorialColumnsBlock.astro';
import InlineBandBlock from '@/components/blocks/InlineBandBlock.astro';
import FaqGroupedBlock from '@/components/blocks/FaqGroupedBlock.astro';
import EventGridBlock from '@/components/blocks/EventGridBlock.astro';
import RuledListBlock from '@/components/blocks/RuledListBlock.astro';
import ContactDetailsBlock from '@/components/blocks/ContactDetailsBlock.astro';
import RequestPanelBlock from '@/components/blocks/RequestPanelBlock.astro';
import CourseRailBlock from '@/components/blocks/CourseRailBlock.astro';
import TickerBlock from '@/components/blocks/TickerBlock.astro';
import FacultyRailBlock from '@/components/blocks/FacultyRailBlock.astro';
import TestimonialRailBlock from '@/components/blocks/TestimonialRailBlock.astro';

interface Props {
  sections?: any[] | null;
  /** Passed to form blocks for the keyless mailto fallback. */
  fallbackEmail?: string;
  /**
   * Passed to the legal statement block, whose built-in accessibility
   * statement offers a phone number when siteSettings carries one.
   */
  fallbackPhone?: string;
  /**
   * Optional draft-aware fetcher, handed to the AUTO blocks so their collection
   * data can be draft content in the Studio preview (2026-08-26, Phase 4).
   * Undefined everywhere else, which lets each query function fall through to
   * its own `= sanityFetch` default, so the live build is unchanged.
   *
   * Only home passes one today: its preview showed draft courses, faculty and
   * testimonials before the conversion (through the old HomeBody special case)
   * and had to keep doing so. The other converted pages' auto blocks still read
   * published data, which the plan's risk register accepts; pass this from their
   * preview branch the day it matters.
   */
  fetcher?: any;
  /**
   * PREVIEW ONLY (2026-08-27). When set, every section that carries a `_key` is
   * wrapped in a plain block box holding a `data-sanity` attribute, which gives
   * the Presentation overlay a section-level edit target: insert before/after,
   * duplicate, remove, drag to reorder, all in the canvas.
   *
   * Only src/pages/preview/[...slug].astro passes it. Absent (every live and
   * static render) there is no wrapper and no attribute, so the rendered HTML is
   * byte-identical to before this prop existed. scripts/page-parity.mjs holds
   * that line.
   */
  editDoc?: EditDoc;
}
const { sections = [], fallbackEmail, fallbackPhone, fetcher, editDoc } = Astro.props;

const MAP: Record<string, any> = {
  sectionRichText: RichTextBlock,
  sectionImageText: ImageTextBlock,
  sectionCardGrid: CardGridBlock,
  sectionQuote: QuoteBlock,
  sectionCtaBand: CtaBandBlock,
  sectionForm: FormRefBlock,
  sectionFeatureCards: FeatureCardsBlock,
  sectionStats: StatsBlock,
  sectionAccordion: AccordionBlock,
  sectionGallery: GalleryBlock,
  sectionSteps: StepsBlock,
  sectionLogos: LogosBlock,
  sectionMediaFeature: MediaFeatureBlock,
  sectionDynamicList: DynamicListBlock,
  sectionMediaShowcase: MediaShowcaseBlock,
  sectionFaqList: FaqListBlock,
  sectionResources: ResourcesBlock,
  sectionKeyDates: KeyDatesBlock,
  sectionPricingTiers: PricingTiersBlock,
  embed: EmbedBlock,
  sectionLegalBody: LegalBodyBlock,
  sectionNumberedCards: NumberedCardsBlock,
  sectionScholarship: ScholarshipBlock,
  sectionLedgerStats: LedgerStatsBlock,
  sectionEditorialColumns: EditorialColumnsBlock,
  sectionInlineBand: InlineBandBlock,
  sectionFaqGrouped: FaqGroupedBlock,
  sectionEventGrid: EventGridBlock,
  sectionRuledList: RuledListBlock,
  sectionContactDetails: ContactDetailsBlock,
  sectionRequestPanel: RequestPanelBlock,
  sectionCourseRail: CourseRailBlock,
  sectionTicker: TickerBlock,
  sectionFacultyRail: FacultyRailBlock,
  sectionTestimonialRail: TestimonialRailBlock,
};

// Blocks that render inner content only and take their background from SectionShell.
const SHELL_AWARE = new Set([
  'sectionRichText', 'sectionImageText', 'sectionCardGrid', 'sectionQuote', 'sectionCtaBand',
  'sectionFeatureCards', 'sectionStats', 'sectionAccordion', 'sectionGallery',
  'sectionSteps', 'sectionLogos', 'sectionMediaFeature', 'sectionDynamicList',
  'sectionMediaShowcase', 'sectionFaqList', 'sectionResources', 'sectionKeyDates',
  'sectionPricingTiers',
]);

// Default background tone when the editor hasn't chosen one (the quote + CTA
// bands were originally chapel green, so they keep that look by default).
const DEFAULT_TONE: Record<string, string> = {
  sectionQuote: 'chapel',
  sectionCtaBand: 'chapel',
};
---

{
  (sections ?? []).map((block: any) => {
    const Cmp = MAP[block?._type];
    if (!Cmp) return null;
    // A shell-aware block can opt OUT of the shell per instance by choosing a
    // fixed Rule & Ledger surface (2026-08-26: sectionPricingTiers is the first,
    // for the Pricing page). It then paints its own <section>, exactly like the
    // ported types below. Absent the field, nothing changes.
    const dt = DEFAULT_TONE[block._type] ?? 'default';
    // Preview-only empty-state coaching (2026-08-28). A section that holds none
    // of its own content renders as a dashed "here is what goes here" note
    // instead of the band of empty padding an editor used to get right after
    // inserting it. Gated on `editDoc`, which ONLY the /preview routes pass, so
    // the live static build takes the identical path it always did.
    // See src/lib/section-coach.ts for the per-type emptiness tests.
    const coach = editDoc ? sectionCoach(block) : null;
    const rendered = coach ? (
      <SectionCoach name={coach.name} hint={coach.hint} />
    ) : SHELL_AWARE.has(block._type) && block.surface !== 'ledger' ? (
        <SectionShell background={block.background} defaultTone={dt}>
          <Cmp block={block} defaultTone={dt} fallbackEmail={fallbackEmail} />
        </SectionShell>
      ) : (
        // `fetcher` reaches the ported/auto types only. The shell-wrapped blocks
        // above are all editor-authored content, with nothing to fetch.
        <Cmp block={block} fallbackEmail={fallbackEmail} fallbackPhone={fallbackPhone} fetcher={fetcher} />
      );
    // Preview only (2026-08-27): the section-level edit target. The wrapper is a
    // plain unstyled div on purpose. It must be a REAL block box, because the
    // overlay outlines the element's rect, and a `display: contents` element has
    // no rect to outline. With no `editDoc` there is no wrapper at all, so the
    // live HTML does not change.
    const editAttr = editDoc && block._key ? sectionEditAttr(editDoc, block._key) : undefined;
    return editAttr ? <div data-sanity={editAttr}>{rendered}</div> : rendered;
  })
}
