---
/* ============================================================================
   SectionCoach — the "here is what goes here" placeholder (PREVIEW ONLY)
   ============================================================================
   Stands in for a page-builder section that has no content yet. An editor who
   adds a section from the picker used to land back on a band of empty padding;
   now they land on a dashed note that names the section and says what to type.

   Deliberately reads as scaffolding and not as content: dashed border, muted
   tones, no brand color, no photo. Nobody should mistake it for the real band.
   Rendered ONLY by src/components/Sections.astro, and only when `editDoc` is
   set (the /preview routes), so it can never reach the live site.

   The layout is single-column and wraps, so it holds at 320px with no
   horizontal overflow.
   ============================================================================ */
interface Props {
  /** The section's plain-language name (the Studio picker's words). */
  name: string;
  /** One sentence: what to add. */
  hint: string;
}
const { name, hint } = Astro.props;
---

<div class="bg-background text-foreground" data-section-coach>
  <div class="px-m py-section-md">
    <div
      class="border-border-soft bg-muted mx-auto flex max-w-2xl flex-col items-center gap-2 rounded-lg border-2 border-dashed px-4 py-10 text-center"
    >
      <p class="tracking-eyebrow text-xs font-bold uppercase opacity-60">Nothing here yet</p>
      <p class="font-display text-h4">{name}</p>
      <p class="max-w-md text-sm leading-relaxed opacity-70">{hint}</p>
    </div>
  </div>
</div>
