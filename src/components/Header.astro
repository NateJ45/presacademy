---
// Foundation, edit with care
// =============================================================================
// The masthead (the 2026-10-13 chrome redesign: "masthead, contents menu and
// back cover"). Top to bottom:
//
//   ▓▓▓▓▓▓▓▓  spine strip: the eight cover colours, static in both themes
//   ░░░░░░░░  green top bar: the issue line (next term) · "Visit a class,
//             free" · the Light / Dark control (tablet and up)
//   The Presbyterian Academy            [covers] Spring 2027 issue → | REQUEST
//   A SCHOOL OF ... · WEST CHESTER ...
//   ════════════════════════════════════════════════  2px rule
//   Courses  Faculty  Pricing  Events ...   EIGHT COURSES · FIVE TEACHERS ...
//   ────────────────────────────────────────────────  1px rule
//
// Phones (and tablets below lg) keep the spine, the bar, the nameplate and its
// subline, and swap the right side and the nav strip for a bordered "Contents"
// button that opens the full-screen Contents menu (MobileNav.tsx).
//
// THE CONDENSED BAR. The masthead stays in normal flow and never shrinks
// (shrinking an in-flow header is layout shift). Instead a SEPARATE bar,
// `position: fixed`, slides in with `transform` once the masthead has scrolled
// out of view, watched by an IntersectionObserver on a 1px sentinel at the
// masthead's foot. While hidden it is aria-hidden and inert, so it is neither
// read nor tabbable. Reduced motion: no slide, it just appears. Fixed plus
// transform means it moves nothing else on the page: zero CLS.
//
// The desktop nav is SERVER-RENDERED (gotcha #5) in MastheadNav.astro, drawn
// here twice (strip and bar). The Contents menu is the only island.
//
// Content: the nav, the button and the identity lines come from Sanity
// siteSettings through resolveSiteSettings; the issue line, the counts and the
// covers from getChromeData (src/lib/queries.ts), turned into words by
// src/lib/chrome.ts. Every one has an inline fallback, so the masthead renders
// cleanly before any content exists.
// =============================================================================

import { resolveSiteSettings, type RawSiteSettings } from '@/lib/siteSettings';
import { site } from '@/data/site';
import { getChromeData } from '@/lib/queries';
import { issueLine } from '@/lib/term-issue';
import { menuFact, navNote, orderShelf } from '@/lib/chrome';
import { COVER_COLORS, coverStyle, resolveCover, type CoverColor } from '@/lib/cover';
import SanityImage from './SanityImage.astro';
import ThemeToggle from './ThemeToggle';
import MobileNav from './MobileNav';
import MastheadNav from './MastheadNav.astro';

interface Props {
  siteSettings?: (RawSiteSettings & { siteName?: string }) | null;
}

const { siteSettings } = Astro.props as Props;

// Identity / contact / menus resolve through one shared helper so the header,
// footer, pages and JSON-LD stay in lockstep.
const settings = resolveSiteSettings(siteSettings);
const brandName = settings.brandName;
const logo = settings.logo;
const headerCta = settings.headerCta;
const NAV_ITEMS = settings.headerNav;

// The nameplate: "The Presbyterian" upright, "Academy" italic in the
// theme-aware green, on one line.
const plateLead = site.wordmark.line1;
const plateKey = site.wordmark.line2;

// The subline under the nameplate, in Plex Mono: the tagline and the town.
// Below xl the tagline stands alone (the town is in the footer).
const place = settings.addressLocality ?? '';
// A tagline's closing full stop would sit oddly before the " · ".
const tagline = settings.tagline.replace(/[.\s]+$/, '');
const subline = [tagline, place].filter(Boolean).join(' · ');

// Everything beyond siteSettings, in one request (memoized for the build).
const chrome = await getChromeData();
const counts = {
  courses: chrome.courseCount,
  faculty: chrome.facultyCount,
  lowestPrice: chrome.lowestPrice,
};

// The issue line (Term Issue PR 4): "Spring 2027 term · registration opens Sun
// 15 Nov · first class Tue 26 Jan". Phones get "Spring 2027 · first class 26
// Jan", tablets the term and its state, desktops the whole line. Falls back to
// the tagline when no term is scheduled. The dots are drawn dimmer, so each
// variant is split on them here.
const issue = issueLine(chrome.term, new Date().toISOString().slice(0, 10));
const dotted = (line: string) => line.split(' · ');
const termTag = (chrome.term?.title ?? '').trim();

// The three covers fanned beside "Spring 2027 issue": the next term's courses
// first, then Start here, then featured (chrome.ts orderShelf). Before any
// course exists, three fixed colours stand in so the masthead keeps its shape.
const FALLBACK_FAN: CoverColor[] = ['green', 'oxblood', 'brass'];
const fanCourses = orderShelf(chrome.courses, 3);
const fan: CoverColor[] = FALLBACK_FAN.map((fallback, i) =>
  fanCourses[i] ? resolveCover(fanCourses[i]).color : fallback,
);

// The note at the right of the nav strip, from the real counts.
const note = navNote(counts, settings.addressLocality);

// What the Contents menu needs, as plain data (an island's props are
// serialized into every page, so nothing more than this).
const menuItems = NAV_ITEMS.map((item) =>
  item.kind === 'flat' ? { ...item, note: menuFact(item.href, counts, item.menuNote) } : item,
);
const shelf = orderShelf(chrome.courses, 6).map((c) => {
  const { color, ornament } = resolveCover(c);
  return { title: c.title ?? '', href: `/courses/${c.slug}/`, color, ornament };
});
---

<header class="site-header masthead">
  {/* Spine strip: the eight cover colours, like the spines on a shelf. */}
  <div class="spine" aria-hidden="true">
    {COVER_COLORS.map((c) => (
      <span style={`background: var(--color-cover-${c})`} />
    ))}
  </div>

  {/* Top bar: the issue's running head. Cream on the deepest green, both themes. */}
  <div class="masthead__bar bg-chapel-deep text-chapel-foreground">
    <div class="mx-auto flex h-[34px] max-w-content items-center justify-between gap-m px-4 sm:h-[38px] sm:px-6 lg:px-12">
      {issue ? (
        <a href="/courses/" class="mast-mono hit-44 relative flex min-w-0 hover:text-white">
          {/* Truncation sits on an inner span: an overflow-hidden link would
                clip the .hit-44 tap box drawn by its ::after. */}
          <span class="min-w-0 truncate">
            <span class="sm:hidden">
              {dotted(issue.short).map((p, i) => (
                <>
                  {i > 0 && <span class="mast-dot"> · </span>}
                  {p}
                </>
              ))}
            </span>
            <span class="hidden sm:inline lg:hidden">
              {dotted(issue.medium).map((p, i) => (
                <>
                  {i > 0 && <span class="mast-dot"> · </span>}
                  {p}
                </>
              ))}
            </span>
            <span class="hidden lg:inline">
              {dotted(issue.full).map((p, i) => (
                <>
                  {i > 0 && <span class="mast-dot"> · </span>}
                  {p}
                </>
              ))}
            </span>
          </span>
        </a>
      ) : (
        <p class="mast-mono min-w-0 truncate">{settings.tagline}</p>
      )}

      <div class="flex shrink-0 items-center gap-6">
        {/* The free first class (RequestPanel and RuledList on Get Started say
            the same). Code-owned label, like the type credit in the footer. */}
        <a
          href="/get-started/"
          class="mast-mono hit-44 relative whitespace-nowrap hover:text-white"
        >
          <span class="sm:hidden">Visit free</span>
          <span class="hidden sm:inline">Visit a class, free</span>
          <span aria-hidden="true"> &rarr;</span>
        </a>
        <div class="hidden md:block">
          <ThemeToggle client:idle variant="bar" />
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-12">
    {/* Nameplate row. Phones: 72px tall with a 2px ink rule under it (the nav
        strip carries the rules from lg up). */}
    <div class="masthead__row">
      <div class="min-w-0">
        <a
          href="/"
          class="masthead__plate hit-44 relative"
          aria-label={logo ? `${brandName} home` : undefined}
        >
          {logo ? (
            <SanityImage
              source={logo}
              width={480}
              alt={logo.alt || brandName}
              loading="eager"
              class="h-10 w-auto object-contain lg:h-12"
            />
          ) : (
            <>
              {plateLead}
              {plateKey && (
                <>
                  {' '}
                  <i>{plateKey}</i>
                </>
              )}
              {/* Named by its own text (WCAG 2.5.3), "home" for screen readers. */}
              <span class="sr-only"> home</span>
            </>
          )}
        </a>
        {subline && (
          <p class="masthead__sub mast-mono">
            <span class="xl:hidden">{tagline}</span>
            <span class="hidden xl:inline">{subline}</span>
          </p>
        )}
      </div>

      {/* Desktop: the issue with its fanned covers, a hairline, the button. */}
      <div class="hidden shrink-0 items-center gap-5 lg:flex xl:gap-7">
        <a href="/courses/" class="masthead__issue group">
          <span class="issue-fan" aria-hidden="true">
            <span class="issue-fan__cover issue-fan__cover--l" style={coverStyle(fan[1])} />
            <span class="issue-fan__cover issue-fan__cover--r" style={coverStyle(fan[2])} />
            <span class="issue-fan__cover issue-fan__cover--c" style={coverStyle(fan[0])}>
              <span class="issue-fan__dot" />
            </span>
          </span>
          <span class="flex flex-col gap-[3px]">
            <span class="mast-mono text-[11px] text-muted-foreground">The term catalog</span>
            <span class="font-display text-[19px] leading-[1.1]">
              {termTag ? `${termTag} issue` : 'Course catalog'}{' '}
              <span class="text-chapel-ink" aria-hidden="true">
                &rarr;
              </span>
            </span>
          </span>
        </a>
        {headerCta.show && (
          <>
            <span class="h-11 w-px bg-border" aria-hidden="true" />
            <a href={headerCta.href} class="mast-btn press-tactile">
              {headerCta.label}
            </a>
          </>
        )}
      </div>

      {/* Phones: the Contents button and its full-screen menu. client:idle, not
          client:only: the button server-renders and paints with the page; the
          dialog mounts after hydration, so React stays off the LCP path. */}
      <div class="shrink-0 lg:hidden">
        <MobileNav
          client:idle
          items={menuItems}
          shelf={shelf}
          termTag={termTag}
          cta={headerCta}
          officeHours={settings.officeHours ?? ''}
        />
      </div>
    </div>

    {/* The ruled nav strip (lg up): 2px rule over, 1px under. */}
    <div class="masthead__strip hidden lg:flex">
      <MastheadNav items={NAV_ITEMS} variant="strip" label="Primary" />
      <p class="mast-mono hidden items-center text-[11.5px] tracking-[0.06em] text-muted-foreground xl:flex">
        {note}
      </p>
    </div>
  </div>

  {/* The condensed bar watches this. */}
  <div class="masthead__sentinel" data-masthead-sentinel aria-hidden="true"></div>
</header>

{/* The condensed bar. Outside <header> on purpose: the header carries a
    view-transition-name, and a fixed child inside a captured element snapshots
    at the wrong place during a page swap. Hidden (aria-hidden + inert) until the
    script below shows it. */}
<div class="masthead-bar" data-masthead-bar aria-hidden="true" inert>
  <div class="spine spine--bar" aria-hidden="true">
    {COVER_COLORS.map((c) => (
      <span style={`background: var(--color-cover-${c})`} />
    ))}
  </div>
  <div class="mx-auto flex h-14 max-w-content items-center justify-between gap-4 px-4 sm:px-6 lg:h-[60px] lg:gap-8 lg:px-12">
    <div class="flex shrink-0 items-baseline gap-3.5">
      <a href="/" class="masthead-bar__plate hit-44 relative">
        {plateLead}
        {plateKey && (
          <>
            {' '}
            <i>{plateKey}</i>
          </>
        )}
        <span class="sr-only"> home</span>
      </a>
      {termTag && <span class="term-tag mast-mono hidden xl:inline-block">{termTag}</span>}
    </div>
    {/* Visibility lives on wrappers: the chrome classes set their own
        display in unlayered CSS, which a Tailwind `hidden` cannot beat. */}
    <div class="hidden lg:block">
      <MastheadNav items={NAV_ITEMS} variant="bar" label="Primary, pinned" />
    </div>
    {headerCta.show && (
      <div class="hidden lg:block">
        <a href={headerCta.href} class="mast-btn mast-btn--sm press-tactile">
          {headerCta.label}
        </a>
      </div>
    )}
    {/* Phones: opens the same Contents menu (MobileNav listens for the click
        on any [data-open-contents] and returns focus here on close). */}
    <div class="lg:hidden">
      <button type="button" class="contents-btn" data-open-contents aria-haspopup="dialog">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14">
          <path
            d="M1 3h12M1 7h12M1 11h8"
            stroke="currentColor"
            stroke-width="1.5"
            fill="none"
          ></path>
        </svg>
        Contents
      </button>
    </div>
  </div>
</div>

<style>
  /* Desktop dropdown groups (native <details>): hide the default triangle,
     turn the chevron, and keep the panel hidden until open. */
  .site-nav__group > summary {
    list-style: none;
  }
  .site-nav__group > summary::-webkit-details-marker,
  .site-nav__group > summary::marker {
    display: none;
    content: '';
  }
  .site-nav__group[open] > summary .site-nav__chevron {
    transform: rotate(180deg);
  }
  .site-nav__menu {
    display: none;
  }
  .site-nav__group[open] > .site-nav__menu {
    display: block;
  }
</style>

{/* Progressive enhancement: the dropdown niceties (hover, outside click,
    Escape, close on follow) and the condensed bar. Everything works without
    it: the links are real links and the masthead is always in the page.
    Re-binds on astro:page-load so it survives View Transitions navigations. */}
<script>
  function currentGroups() {
    return Array.from(document.querySelectorAll<HTMLDetailsElement>('.site-nav__group'));
  }

  function closeAllGroups(except?: HTMLDetailsElement) {
    for (const g of currentGroups()) {
      if (g !== except) g.open = false;
    }
  }

  function initHeaderNav() {
    for (const group of currentGroups()) {
      // astro:page-load also fires on the first load, so bind each group once.
      if (group.dataset.bound) continue;
      group.dataset.bound = '1';
      const summary = group.querySelector('summary');
      let closeTimer: number | undefined;
      const cancelClose = () => {
        if (closeTimer) {
          window.clearTimeout(closeTimer);
          closeTimer = undefined;
        }
      };
      // Hover intent: open on enter, close after a short delay on leave.
      // Pointers that can hover only (touch is skipped).
      group.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'touch') return;
        cancelClose();
        closeAllGroups(group);
        group.open = true;
      });
      group.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'touch') return;
        cancelClose();
        closeTimer = window.setTimeout(() => {
          group.open = false;
        }, 140);
      });
      // <details> toggles AFTER this handler: about to open, close the rest.
      summary?.addEventListener('click', () => {
        if (!group.open) closeAllGroups(group);
      });
      group.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          group.open = false;
        });
      });
    }
  }

  // ---- The condensed bar ----------------------------------------------------
  // Shown once the sentinel at the masthead's foot has scrolled ABOVE the
  // viewport (not merely out of it, which a short window would also report).
  // The observer is created per page and dropped before View Transitions
  // swaps the DOM, so it never watches a detached node.
  type BarWindow = typeof window & { __mastheadIO?: IntersectionObserver };

  function initMastheadBar() {
    const w = window as BarWindow;
    w.__mastheadIO?.disconnect();
    const bar = document.querySelector<HTMLElement>('[data-masthead-bar]');
    const sentinel = document.querySelector<HTMLElement>('[data-masthead-sentinel]');
    if (!bar || !sentinel || !('IntersectionObserver' in window)) return;

    const setShown = (shown: boolean) => {
      if (bar.hasAttribute('data-shown') === shown) return;
      if (shown) {
        bar.setAttribute('data-shown', '');
        bar.removeAttribute('aria-hidden');
        bar.inert = false;
      } else {
        // Never strand keyboard focus inside a bar that is leaving.
        if (bar.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
        bar.removeAttribute('data-shown');
        bar.setAttribute('aria-hidden', 'true');
        bar.inert = true;
        bar.querySelectorAll<HTMLDetailsElement>('details[open]').forEach((d) => (d.open = false));
      }
    };

    const io = new IntersectionObserver(([entry]) => {
      setShown(!entry.isIntersecting && entry.boundingClientRect.top < 0);
    });
    io.observe(sentinel);
    w.__mastheadIO = io;
  }

  // Document-level listeners bind ONCE (guarded by a window flag), and query
  // the nav fresh each time, so they cover the swapped-in DOM too.
  const w = window as typeof window & { __headerNavBound?: boolean };
  if (!w.__headerNavBound) {
    w.__headerNavBound = true;
    document.addEventListener('pointerdown', (e) => {
      const target = e.target as Node;
      if (!currentGroups().some((g) => g.contains(target))) closeAllGroups();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const openGroup = currentGroups().find((g) => g.open);
      if (openGroup) {
        openGroup.open = false;
        openGroup.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('astro:before-swap', () => {
      (window as BarWindow).__mastheadIO?.disconnect();
    });
  }

  initHeaderNav();
  initMastheadBar();
  document.addEventListener('astro:page-load', () => {
    initHeaderNav();
    initMastheadBar();
  });
</script>
