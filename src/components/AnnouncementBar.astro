---
/* ============================================================================
   AnnouncementBar — the slim site-wide notice above the header
   ============================================================================
   Extracted out of BaseLayout on 2026-08-28 so the /preview shell can render
   the SAME bar, draft-aware, and an editor can see a notice before it is live.
   The markup is byte-for-byte what BaseLayout rendered inline before the
   extraction; scripts/page-parity.mjs is the gate on that.

   Nothing renders when there is no active announcement, which is why the
   live pages of a dataset with no announcement are unchanged.

   Single line of centered text that wraps: no fixed widths, no flex row, so it
   holds at 320px with no horizontal overflow.
   ============================================================================ */
interface Props {
  /** The active announcement, or null. Loose shape: it comes straight from GROQ. */
  announcement?: any;
  /**
   * PREVIEW ONLY. A `data-sanity` value pointing at the announcement document,
   * so a click in Edit mode opens it in the Presentation edit panel. Absent on
   * every live render, and then no wrapper element is emitted at all.
   */
  editAttr?: string;
}
const { announcement = null, editAttr } = Astro.props;

const showAnnouncement = !!announcement?.message;
const ANNOUNCEMENT_STYLES: Record<string, string> = {
  info: 'bg-chapel text-chapel-foreground',
  special: 'bg-primary text-primary-foreground',
  urgent: 'bg-destructive text-white',
};
const announcementClass =
  ANNOUNCEMENT_STYLES[announcement?.style ?? 'info'] ?? ANNOUNCEMENT_STYLES.info;
---

{
  showAnnouncement &&
    (editAttr ? (
      <div data-sanity={editAttr}>
        <div class:list={[announcementClass, 'text-center text-sm px-m py-2']}>
          <span>{announcement.message}</span>
          {announcement.link?.url && announcement.link?.label && (
            <a
              href={announcement.link.url}
              class="ml-2 underline underline-offset-2 font-semibold hover:opacity-80 transition-opacity"
            >
              {announcement.link.label}
            </a>
          )}
        </div>
      </div>
    ) : (
      <div class:list={[announcementClass, 'text-center text-sm px-m py-2']}>
        <span>{announcement.message}</span>
        {announcement.link?.url && announcement.link?.label && (
          <a
            href={announcement.link.url}
            class="ml-2 underline underline-offset-2 font-semibold hover:opacity-80 transition-opacity"
          >
            {announcement.link.label}
          </a>
        )}
      </div>
    ))
}
