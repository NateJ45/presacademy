---
// Foundation, edit with care
// Page-builder renderer. Maps each flexibleSections block (_type) to its
// on-brand component. Unknown types are skipped. Used by the generic `page`
// type at /[slug] and any page that adds a flexibleSections[] field.
//
// THE STARTER'S FOUNDATIONS (refoundation phase A, 2026-10-27). This file was
// Sections.astro; it now carries the starter's SectionRenderer layer on top of
// the Academy's own block MAP, so the Academy can take the starter's blocks
// later (phase B) without a second renderer:
//   - the cadence (src/lib/sectionCadence.ts) classifies every row first. All
//     of the Academy's blocks are SELF-CONTAINED there (they paint their own
//     band), so it assigns no surface and draws no divider between them today;
//   - named anchors (src/lib/section-anchors.ts, starter card 158) sit behind
//     the `anchors` prop. 'named' (the default since phase A2) keeps every id
//     a block already draws and names only the headings that had none;
//   - the accent budget (src/lib/cta-budget.ts, cards 158 and 187, phase A2):
//     one filled pill per page body, the first that does not repeat the
//     header's button; every other one is outlined (src/lib/pill-variant.ts).
// Everything below the frontmatter renders what Sections.astro did, plus the
// anchor and the button variant above.
//
// THE BUILDER KIT (phase B, 2026-10-27, starter cards 173 and 193): the
// starter's smaller blocks (columns, fold-outs, tabs, event details, a notice,
// a letter, steps, a hub...) take one branch, isBuilderBlock(), and
// BuilderBlock.astro picks the component. They are CONTENT blocks in the
// cadence, so they take the surface it hands them (Paper or Warm, or the green
// Feature band a look asks for). No live page holds one yet.
//
// Shell-aware blocks (the newer, tone-adaptive ones) render their inner content
// only and are wrapped in <SectionShell> so a single editor control sets their
// background (token tone, or image/video with overlay). The original blocks
// render their own section background and are passed through unwrapped.
import SectionShell from '@/components/SectionShell.astro';
import SectionCoach from '@/components/SectionCoach.astro';
import { sectionEditAttr, sectionFieldEditAttr, type EditDoc } from '@/lib/preview-edit-attr';
import { sectionCoach } from '@/lib/section-coach';
import { backgroundApplies } from '@/lib/section-fields';
import type { SurfaceValue } from '@/lib/surfaces';
import { expandSyncedSections } from '@/lib/authoring';
import { classifySections } from '@/lib/sectionCadence';
import { sectionAnchors, sectionHeadingText } from '@/lib/section-anchors';
import { primaryBudget, repeatsHeaderCta } from '@/lib/cta-budget';
import { getSiteSettings } from '@/lib/queries';
import { resolveSiteSettings } from '@/lib/siteSettings';
import { ctaHref } from '@/lib/cta-href';
import BuilderBlock from '@/components/builder-blocks/BuilderBlock.astro';
import { isBuilderBlock } from '@/lib/builderBlocks.types';
import RichTextBlock from '@/components/blocks/RichTextBlock.astro';
import ImageTextBlock from '@/components/blocks/ImageTextBlock.astro';
import CardGridBlock from '@/components/blocks/CardGridBlock.astro';
import QuoteBlock from '@/components/blocks/QuoteBlock.astro';
import CtaBandBlock from '@/components/blocks/CtaBandBlock.astro';
import FormRefBlock from '@/components/blocks/FormRefBlock.astro';
import FeatureCardsBlock from '@/components/blocks/FeatureCardsBlock.astro';
import StatsBlock from '@/components/blocks/StatsBlock.astro';
import AccordionBlock from '@/components/blocks/AccordionBlock.astro';
import GalleryBlock from '@/components/blocks/GalleryBlock.astro';
import StepsBlock from '@/components/blocks/StepsBlock.astro';
import LogosBlock from '@/components/blocks/LogosBlock.astro';
import MediaFeatureBlock from '@/components/blocks/MediaFeatureBlock.astro';
import DynamicListBlock from '@/components/blocks/DynamicListBlock.astro';
import MediaShowcaseBlock from '@/components/blocks/MediaShowcaseBlock.astro';
import FaqListBlock from '@/components/blocks/FaqListBlock.astro';
import ResourcesBlock from '@/components/blocks/ResourcesBlock.astro';
import KeyDatesBlock from '@/components/blocks/KeyDatesBlock.astro';
import PricingTiersBlock from '@/components/blocks/PricingTiersBlock.astro';
import EmbedBlock from '@/components/EmbedBlock.astro';
// Ported page sections (Rule & Ledger), 2026-08-26. These render their own
// fixed surfaces and stay OUT of SHELL_AWARE on purpose (decision D1).
import LegalBodyBlock from '@/components/blocks/LegalBodyBlock.astro';
import NumberedCardsBlock from '@/components/blocks/NumberedCardsBlock.astro';
import ScholarshipBlock from '@/components/blocks/ScholarshipBlock.astro';
import LedgerStatsBlock from '@/components/blocks/LedgerStatsBlock.astro';
import EditorialColumnsBlock from '@/components/blocks/EditorialColumnsBlock.astro';
import InlineBandBlock from '@/components/blocks/InlineBandBlock.astro';
import FaqGroupedBlock from '@/components/blocks/FaqGroupedBlock.astro';
import EventGridBlock from '@/components/blocks/EventGridBlock.astro';
import RuledListBlock from '@/components/blocks/RuledListBlock.astro';
import ContactDetailsBlock from '@/components/blocks/ContactDetailsBlock.astro';
import RequestPanelBlock from '@/components/blocks/RequestPanelBlock.astro';
import CourseRailBlock from '@/components/blocks/CourseRailBlock.astro';
import TickerBlock from '@/components/blocks/TickerBlock.astro';
import FacultyRailBlock from '@/components/blocks/FacultyRailBlock.astro';
import TestimonialRailBlock from '@/components/blocks/TestimonialRailBlock.astro';
// The Term Issue home (2026-10-13, PR 2). Fixed surfaces, outside the shell.
import TermContentsBlock from '@/components/blocks/TermContentsBlock.astro';
import CourseFinderBlock from '@/components/blocks/CourseFinderBlock.astro';
// The issue's back page (2026-10-13, PR 4). Fixed dark ink band, outside the shell.
import NextIssueBlock from '@/components/blocks/NextIssueBlock.astro';
import ForPastorsBlock from '@/components/blocks/ForPastorsBlock.astro';

interface Props {
  sections?: any[] | null;
  /** Passed to form blocks for the keyless mailto fallback. */
  fallbackEmail?: string;
  /**
   * Passed to the legal statement block, whose built-in accessibility
   * statement offers a phone number when siteSettings carries one.
   */
  fallbackPhone?: string;
  /**
   * Optional draft-aware fetcher, handed to the AUTO blocks so their collection
   * data can be draft content in the Studio preview (2026-08-26, Phase 4).
   * Undefined everywhere else, which lets each query function fall through to
   * its own `= sanityFetch` default, so the live build is unchanged.
   *
   * Only home passes one today: its preview showed draft courses, faculty and
   * testimonials before the conversion (through the old HomeBody special case)
   * and had to keep doing so. The other converted pages' auto blocks still read
   * published data, which the plan's risk register accepts; pass this from their
   * preview branch the day it matters.
   */
  fetcher?: any;
  /**
   * PREVIEW ONLY (2026-08-27). When set, every section that carries a `_key` is
   * wrapped in a plain block box holding a `data-sanity` attribute, which gives
   * the Presentation overlay a section-level edit target: insert before/after,
   * duplicate, remove, drag to reorder, all in the canvas.
   *
   * Only src/pages/preview/[...slug].astro passes it. Absent (every live and
   * static render) there is no wrapper and no attribute, so the rendered HTML is
   * byte-identical to before this prop existed. scripts/page-parity.mjs holds
   * that line.
   */
  editDoc?: EditDoc;
  /** Prefix for the cadence's numbered ids, so two renderers on a page do not collide. */
  idPrefix?: string;
  /**
   * 'numbered': every block keeps the id it draws itself (an editor-set
   * `headingId`, or the block's built-in one) and nothing more. Pages that draw
   * several renderers (the style guide's fixtures) pass it so ids stay unique.
   * 'named' (the default): as numbered, and a section whose block draws its heading WITHOUT an id takes one
   * made from the heading, so /about/#our-story links to it (starter card 158).
   * Ids a block already draws are never renamed, so no published link breaks.
   */
  anchors?: 'named' | 'numbered';
}
const {
  sections = [],
  fallbackEmail,
  fallbackPhone,
  fetcher,
  editDoc,
  idPrefix = 'section',
  anchors = 'named',
} = Astro.props;

const MAP: Record<string, any> = {
  sectionRichText: RichTextBlock,
  sectionImageText: ImageTextBlock,
  sectionCardGrid: CardGridBlock,
  sectionQuote: QuoteBlock,
  sectionCtaBand: CtaBandBlock,
  sectionForm: FormRefBlock,
  sectionFeatureCards: FeatureCardsBlock,
  sectionStats: StatsBlock,
  sectionAccordion: AccordionBlock,
  sectionGallery: GalleryBlock,
  sectionSteps: StepsBlock,
  sectionLogos: LogosBlock,
  sectionMediaFeature: MediaFeatureBlock,
  sectionDynamicList: DynamicListBlock,
  sectionMediaShowcase: MediaShowcaseBlock,
  sectionFaqList: FaqListBlock,
  sectionResources: ResourcesBlock,
  sectionKeyDates: KeyDatesBlock,
  sectionPricingTiers: PricingTiersBlock,
  embed: EmbedBlock,
  sectionLegalBody: LegalBodyBlock,
  sectionNumberedCards: NumberedCardsBlock,
  sectionScholarship: ScholarshipBlock,
  sectionLedgerStats: LedgerStatsBlock,
  sectionEditorialColumns: EditorialColumnsBlock,
  sectionInlineBand: InlineBandBlock,
  sectionFaqGrouped: FaqGroupedBlock,
  sectionEventGrid: EventGridBlock,
  sectionRuledList: RuledListBlock,
  sectionContactDetails: ContactDetailsBlock,
  sectionRequestPanel: RequestPanelBlock,
  sectionCourseRail: CourseRailBlock,
  sectionTicker: TickerBlock,
  sectionFacultyRail: FacultyRailBlock,
  sectionTestimonialRail: TestimonialRailBlock,
  sectionTermContents: TermContentsBlock,
  sectionCourseFinder: CourseFinderBlock,
  sectionNextIssue: NextIssueBlock,
  sectionForPastors: ForPastorsBlock,
};

// Blocks that render inner content only and take their background from SectionShell.
const SHELL_AWARE = new Set([
  'sectionRichText',
  'sectionImageText',
  'sectionCardGrid',
  'sectionQuote',
  'sectionCtaBand',
  'sectionFeatureCards',
  'sectionStats',
  'sectionAccordion',
  'sectionGallery',
  'sectionSteps',
  'sectionLogos',
  'sectionMediaFeature',
  'sectionDynamicList',
  'sectionMediaShowcase',
  'sectionFaqList',
  'sectionResources',
  'sectionKeyDates',
  'sectionPricingTiers',
]);

// Default background tone when the editor hasn't chosen one (the quote + CTA
// bands were originally chapel green, so they keep that look by default).
const DEFAULT_TONE: Record<string, SurfaceValue> = {
  sectionQuote: 'chapel',
  sectionCtaBand: 'chapel',
};

// ---------------------------------------------------------------------------
// The starter's foundation layer (refoundation phase A, 2026-10-27)
// ---------------------------------------------------------------------------
// Synced sections (the authoring kit, PORTS.md card 109) are swapped for the
// sections their saved copy holds BEFORE the cadence runs, so a synced band
// takes its place in the rhythm like any typed-in band. Each expanded section
// carries `_editKey`, the synced block's own key, so the preview's controls
// act on the block that is really in the page.
const classified = classifySections<{ _type: string }>(
  expandSyncedSections(sections ?? []),
  idPrefix,
);

// Named anchors (starter card 158), adapted: the Academy's blocks already draw
// their own ids (an editor-set `headingId`, or a built-in one such as
// 'contents' or 'next-issue'). Those are published anchors and never move. Only
// a block that would draw its heading with NO id takes a name from its heading,
// through the `headingId` field every Academy block already reads.
const OWN_ANCHOR: Record<string, string> = {
  sectionCourseFinder: 'finder',
  sectionCourseRail: 'course-rail',
  sectionEventGrid: 'upcoming-heading',
  sectionFacultyRail: 'faculty-rail',
  sectionForPastors: 'for-pastors',
  sectionNextIssue: 'next-issue',
  sectionRuledList: 'recurring-heading',
  sectionTermContents: 'contents',
  sectionTestimonialRail: 'testimonial-rail',
};
// Ids the page chrome around the renderer draws (the closing band, the back cover).
const CHROME_IDS = ['final-cta', 'bc-colophon', 'bc-issue', 'bc-index'];
const ownAnchor = (b: any): string | undefined =>
  (typeof b?.headingId === 'string' && b.headingId.trim()) ||
  OWN_ANCHOR[b?._type] ||
  // The Term Issue rates box draws its own 'rates' id (PricingTiersBlock).
  (b?._type === 'sectionPricingTiers' && b?.surface === 'rates' ? 'rates' : undefined);
const named =
  anchors === 'named'
    ? sectionAnchors(
        classified.map(({ block, headingId }) => ({
          // A block that draws its own id takes no name; its id is reserved below.
          heading: ownAnchor(block) ? undefined : sectionHeadingText(block),
          fallback: headingId,
        })),
        {
          reserved: [
            ...CHROME_IDS,
            ...classified.map(({ block }) => ownAnchor(block)).filter((id): id is string => !!id),
          ],
        },
      )
    : null;
const rows = classified.map((row, i) => {
  if (!named || ownAnchor(row.block) || !sectionHeadingText(row.block)) return row;
  return { ...row, block: { ...row.block, headingId: named[i] } };
});

// One filled pill per page body (src/lib/cta-budget.ts, cards 158 and 187),
// adapted to the Academy's blocks: the first block whose main button is a
// filled pill keeps it; every later one draws the outlined pill. A button that
// goes where the header's button goes ("Request information") repeats it, so
// it is outlined without spending the budget. The page's hero and closing
// band are drawn outside this renderer and are not counted. Form submit
// buttons are not calls to action and are never counted or changed.
const headerCta = resolveSiteSettings(await getSiteSettings()).headerCta;
const own = (href: unknown) => typeof href === 'string' && !repeatsHeaderCta(href, headerCta);
const ctaVariant = primaryBudget(rows, ({ block }: { block: any }) => {
  switch (block?._type) {
    case 'sectionInlineBand':
      return !!block.headline && own(block.ctaUrl || '/faculty/');
    case 'sectionPricingTiers':
      return block.surface === 'rates' && own(block.couponCtaHref || '/get-started/');
    case 'sectionRequestPanel':
      // Its intro button: Calendly, or an email when no booking link is set.
      return true;
    case 'sectionCtaBand':
      return !!block.headline && !!block.ctaLabel && own(block.ctaUrl);
    case 'sectionImageText':
    case 'sectionMediaFeature':
      return !!block.ctaLabel && own(block.ctaUrl);
    // The builder kit (cards 173 and 193): the event's main button, the contact
    // card's big Call (or Email) button and the steps rail's closing button.
    case 'eventDetailsSection':
      return !!block.button?.label && own(ctaHref(block.button));
    case 'contactCardSection':
      return block.callButtons === true;
    case 'stepsRailSection':
      return !!block.link?.label && own(ctaHref(block.link));
    default:
      return false;
  }
});
---

{rows.map(
  (
    { block, surface, headingId }: { block: any; surface: any; headingId: string },
    rowIndex: number,
  ) => {
    // Synced sections (the authoring kit, PORTS.md card 109) were swapped above
    // for the sections their saved copy holds; each carries `_editKey`, the
    // synced block's own key, so the preview's controls act on the block that
    // is really in the page.
    const builder = !!block?._type && isBuilderBlock(block);
    const Cmp = MAP[block?._type];
    if (!Cmp && !builder) return null;
    // A shell-aware block can opt OUT of the shell per instance by choosing a
    // fixed Rule & Ledger surface (2026-08-26: sectionPricingTiers is the first,
    // for the Pricing page). It then paints its own <section>, exactly like the
    // ported types below. Absent the field, nothing changes. The Term Issue
    // rates box (surface "rates", 2026-10-13) opts out the same way.
    const dt = DEFAULT_TONE[block._type] ?? 'default';
    // Preview-only empty-state coaching (2026-08-28). A section that holds none
    // of its own content renders as a dashed "here is what goes here" note
    // instead of the band of empty padding an editor used to get right after
    // inserting it. Gated on `editDoc`, which ONLY the /preview routes pass, so
    // the live static build takes the identical path it always did.
    // See src/lib/section-coach.ts for the per-type emptiness tests.
    const coach = editDoc ? sectionCoach(block) : null;
    const rendered = coach ? (
      <SectionCoach name={coach.name} hint={coach.hint} />
    ) : builder ? (
      // The builder kit: one branch, BuilderBlock picks the component. A named
      // anchor (above) wins over the cadence's numbered id.
      <BuilderBlock
        block={block}
        surface={surface ?? 'background'}
        headingId={(block as { headingId?: string }).headingId || headingId}
        primaryVariant={ctaVariant(rowIndex)}
        isFirst={rowIndex === 0}
      />
    ) : SHELL_AWARE.has(block._type) && block.surface !== 'ledger' && block.surface !== 'rates' ? (
      <SectionShell background={block.background} defaultTone={dt}>
        <Cmp
          block={block}
          defaultTone={dt}
          fallbackEmail={fallbackEmail}
          primaryVariant={ctaVariant(rowIndex)}
        />
      </SectionShell>
    ) : (
      // `fetcher` reaches the ported/auto types only. The shell-wrapped blocks
      // above are all editor-authored content, with nothing to fetch.
      <Cmp
        block={block}
        fallbackEmail={fallbackEmail}
        fallbackPhone={fallbackPhone}
        fetcher={fetcher}
        primaryVariant={ctaVariant(rowIndex)}
      />
    );
    // Preview only (2026-08-27): the section-level edit target. The wrapper is a
    // plain unstyled div on purpose. It must be a REAL block box, because the
    // overlay outlines the element's rect, and a `display: contents` element has
    // no rect to outline. With no `editDoc` there is no wrapper at all, so the
    // live HTML does not change.
    const editKey: string | undefined = block._editKey ?? block._key;
    const editAttr = editDoc && editKey ? sectionEditAttr(editDoc, editKey) : undefined;
    // ---------------------------------------------------------------------
    // The surface handle (2026-08-28) — PREVIEW ONLY, same `editDoc` gate
    // ---------------------------------------------------------------------
    // The in-canvas swatch row needs a node the Studio schema resolves to a
    // FIELD; the wrapper above names a bare array item, which resolves to none,
    // so a custom overlay component can never mount on it (verified in a
    // deployed Studio, see sectionFieldEditAttr). This little square is that
    // node: it points at the section's `background` object, so clicking it
    // selects that field and the overlay answers with the swatch row.
    //
    // Exactly one per section, and only for section types that HAVE a
    // background — the Rule & Ledger sections come styled to match the page
    // they belong to and get no handle at all.
    //
    // TOP-RIGHT, INSIDE the band, not the bottom-right corner the controls
    // were first specced for. A section is usually taller than the viewport, so
    // its bottom-right corner is below the fold exactly when the editor is
    // looking at the section; its top-right is on screen the moment the band
    // is. It renders after the content so it paints above it, and it carries
    // its styles inline because this shell loads no preview-only stylesheet.
    const handleAttr =
      editAttr && editDoc && block._key && !block._editKey && backgroundApplies(block._type, block)
        ? sectionFieldEditAttr(editDoc, block._key, 'background')
        : undefined;
    return editAttr ? (
      <div data-sanity={editAttr} style="position:relative">
        {rendered}
        {handleAttr && (
          <div
            data-sanity={handleAttr}
            data-surface-handle
            title="Section colors"
            aria-hidden="true"
            style="position:absolute;top:12px;right:12px;z-index:5;width:28px;height:28px;border-radius:999px;background:#FFFFFF;border:1px solid rgba(31,27,24,0.18);box-shadow:0 2px 8px rgba(31,27,24,0.18);display:flex;align-items:center;justify-content:center;font-size:15px;line-height:1;"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="5" cy="5.5" r="3" fill="#33503F" />
              <circle cx="11" cy="5.5" r="3" fill="#C7A875" />
              <circle cx="8" cy="11" r="3" fill="#7A2A2C" />
            </svg>
          </div>
        )}
      </div>
    ) : (
      rendered
    );
  },
)}
