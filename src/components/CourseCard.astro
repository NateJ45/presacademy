---
// Safe to edit by hand.
// Course card: since the Term Issue redesign (2026-10-13) the card IS the
// course cover (CourseCover.astro, flip mode). On a desktop with a mouse it
// turns over on hover or keyboard focus to show the course's question, week
// one and facts; on touch, or with reduced motion, that back content sits
// beside the cover (phones) or below it (sm up), so nothing is hover-only.
// Under a flipping cover the one-line facts ledger (next term, sessions,
// price) stays visible.
//
// Used on the catalog grid, the home catalog preview, and the "Start here"
// rail. The <li> carries the data-* attributes the catalog filter island
// (CourseFilters.tsx) reads to show or hide it via the shared
// .is-filtered-out utility: keep data-course-card, data-topics, data-teachers
// and data-term exactly as they are.
//
// The old photo cover well is gone from the card: a course photo, when there
// is one, belongs on the course page, and the typographic cover means a course
// without a photo no longer shows an empty image well.

import CourseCover from '@/components/CourseCover.astro';

interface Props {
  course: any;
  /** Kept for callers that still pass it; covers have no images to load. */
  eager?: boolean;
}
const { course } = Astro.props;

const topicSlugs = (course.teachingAreas ?? [])
  .map((t: any) => t.slug)
  .filter(Boolean)
  .join(' ');
const teacherSlugs = (course.instructors ?? [])
  .map((i: any) => i.slug)
  .filter(Boolean)
  .join(' ');
const termSlug = course.nextOffering?.term?.slug ?? '';
---

<li
  data-course-card
  data-topics={topicSlugs}
  data-teachers={teacherSlugs}
  data-term={termSlug}
  class="list-none"
>
  <CourseCover course={course} size="md" flip />
</li>
