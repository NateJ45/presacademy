---
// Safe to edit by hand for copy + structure changes.
// FAQ page. Questions come from the faqItem collection in Sanity, grouped by
// category in the order set on the section, so editors add, edit, and reorder
// questions without touching code. When the collection is empty (e.g. Sanity not
// configured) the page falls back to a built-in starter set, so it is never
// broken or empty. Rendered as a native (no-JS) accordion.
//
// CONVERTED TO THE PAGE BUILDER 2026-08-26 (Phase 2 of
// docs/superpowers/plans/2026-08-26-page-builder-conversion.md). The accordion
// is now a `sectionFaqGrouped` block in the page's "Page sections" array,
// rendered by SingletonPage; the block fetches the FAQ collection itself.
//
// THE FAQPage JSON-LD STAYS HERE, by doctrine: all structured data is emitted
// from page frontmatter. That is why this file still fetches the questions —
// not to render them, but to describe them to search engines. Both paths read
// the same collection with the same projection and the same built-in fallback
// (src/lib/faq-fallback.ts), so the markup and the schema cannot disagree.
//
// The photo hero also stays here: its scoped .hero-fill style has to live in
// the pages that use it, or every text-hero page inherits the style tag (see
// the note in SingletonPage.astro).

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getFaqPage, getSiteSettings } from '@/lib/queries';
import heroFaq from '@/assets/placeholders/acad-friends-talking.jpg';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { resolveSiteSettings } from '@/lib/siteSettings';
import Hero from '@/components/Hero.astro';
import SingletonPage from '@/components/SingletonPage.astro';
import { FALLBACK_FAQS } from '@/lib/faq-fallback';

const [siteSettings, page] = await Promise.all([
  getSiteSettings().catch(() => null),
  getFaqPage().catch(() => null),
]);
const settings = resolveSiteSettings(siteSettings);

const title = page?.seoTitle ?? `Frequently Asked Questions · ${site.name}`;
const description =
  page?.seoDescription ??
  'Common questions about courses, format, cost, scholarships, who it is for, and our Reformed identity.';

const heroEyebrow = page?.heroEyebrow ?? 'Common Questions';
const heroHeadline = page?.heroHeadline ?? 'Everything you want to know';
const heroSubhead =
  page?.heroSubhead ??
  'If your question is not here, just ask. We are happy to help you figure out whether the Academy is a fit.';

// The list the JSON-LD describes: the collection, or the built-in starter set,
// the same choice the block makes when it renders.
const faqs: any[] = Array.isArray(page?.faqs) && page.faqs.length > 0 ? page.faqs : FALLBACK_FAQS;

// Flatten a Portable Text answer (or pass a string through) for the JSON-LD.
function answerText(a: any): string {
  if (typeof a === 'string') return a;
  if (Array.isArray(a)) {
    return a
      .map((block) => (block?.children ?? []).map((c: any) => c?.text ?? '').join(''))
      .join(' ')
      .trim();
  }
  return '';
}

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: answerText(f.answer) },
  })),
});

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'FAQ', url: `${site.url}/faq` },
  ]),
  faqSchema,
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} seoImage={page?.seoImage} hideFromSearch={page?.hideFromSearch === true}>
  <SingletonPage
    pageType="faqPage"
    {page}
    {settings}
    finalCtaBackgroundImage={page?.finalCtaBackgroundImage}
    finalCtaFallbacks={{
      eyebrow: 'Still wondering?',
      headline: 'Ask us anything',
      subhead: 'If your question is not here, send it our way and we will answer plainly.',
      cta: { label: 'Get in touch', linkType: 'external', externalUrl: '/get-started' },
    }}
  >
    {/* Hero — photo variant, short height. Rendered here rather than inside
        SingletonPage so its scoped style stays on the pages that use it. */}
    <Hero
      slot="hero"
      eyebrow={heroEyebrow}
      headline={heroHeadline}
      subhead={heroSubhead}
      keyword={page?.heroKeyword}
      backgroundImage={page?.heroImage ?? null}
      localImage={heroFaq}
      localImageAlt="Three students talking together"
      headingId="faq-hero"
      size="short"
    />
  </SingletonPage>
</BaseLayout>
