---
// Safe to edit by hand
// Accessibility statement page.
//
// CONVERTED TO THE PAGE BUILDER 2026-08-26 (Phase 1 of
// docs/superpowers/plans/2026-08-26-page-builder-conversion.md), as privacy's
// twin: the statement body is now a `sectionLegalBody` block in "Page
// sections", rendered by SingletonPage. What stays here is the queries, the SEO
// derivation, the breadcrumb JSON-LD, and the photo hero (its scoped
// .hero-fill style has to live in the pages that use it; see the note in
// SingletonPage.astro).
//
// The barrier-report contact (email + phone) still resolves through
// siteSettings, so it stays single-sourced with the header, footer, and contact
// page: SingletonPage passes both down to the block. A clear, monitored way to
// report a problem is the part of an accessibility statement that matters most,
// so it renders even when the body falls back to the built-in statement.
//
// The old `body` and `lastUpdated` fields are deliberately left in place and
// populated (decision D4, additive migration). They get unset in the cleanup
// phase, never by clicking "Remove field" in the Studio.

import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import heroAccessibility from '@/assets/placeholders/acad-library-room.jpg';
import SingletonPage from '@/components/SingletonPage.astro';
import { getAccessibilityPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { resolveSiteSettings } from '@/lib/siteSettings';

const [page, siteSettings] = await Promise.all([
  getAccessibilityPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);
const settings = resolveSiteSettings(siteSettings);

const title       = page?.seoTitle       ?? `Accessibility · ${site.name}`;
const description = page?.seoDescription ?? 'How we make this site usable for everyone, and how to tell us if something gets in your way.';

const heroEyebrow  = page?.heroEyebrow  ?? 'Built for everyone.';
const heroHeadline = page?.heroHeadline ?? 'Accessibility';
const heroSubhead  = page?.heroSubhead  ?? '';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Accessibility', url: `${site.url}/accessibility` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} seoImage={page?.seoImage}>
  <SingletonPage pageType="accessibilityPage" {page} {settings}>
    {/* Hero — photo variant, short height. Rendered here rather than inside
        SingletonPage so its scoped style stays on the pages that use it. */}
    <Hero
      slot="hero"
      eyebrow={heroEyebrow}
      headline={heroHeadline}
      subhead={heroSubhead}
      backgroundImage={page?.heroImage ?? null}
      localImage={heroAccessibility}
      localImageAlt="A university library reading room"
      headingId="accessibility-hero-heading"
      size="short"
    />
  </SingletonPage>
</BaseLayout>
