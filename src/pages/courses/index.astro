---
// Safe to edit by hand for copy + structure changes.
// Course catalog. Server-renders every course card (good for SEO + no-JS) plus
// a "Start here" rail, with a progressive-enhancement filter island over the
// top. Rule & Ledger layout: a ruled section header, a left filter rail, and a
// squared card grid. Falls back to an empty-state line before Sanity is seeded.
//
// CONVERTED TO THE PAGE BUILDER 2026-08-26 (Phase 3 of
// docs/superpowers/plans/2026-08-26-page-builder-conversion.md), and the first
// page with a PINNED CODE REGION.
//
// What converted: the hero (PageHeader, through SingletonPage's hero map) and
// the "Start here" rail, which is now a `sectionCourseRail` block in the page's
// "Page sections" array.
//
// What did not: the catalog. The React filter island, its four-collection facet
// counting, the sr-only heading and the empty state stay code by doctrine (the
// plan's "Stays code, deliberately"), and render through SingletonPage's
// "pinned" slot, which sits between the sections array and the closing CTA.
// That reproduces today's order exactly, because this page's sections array is
// empty in the dataset. SingletonPage's header records what the ordering does
// and does not allow once an editor adds a section.
//
// The old `startHereEyebrow`, `startHereHeadline` and `emptyState` fields are
// deliberately left in place and populated (decision D4, additive migration):
// reverting this file brings the old page back with its content intact. They
// get unset in the cleanup phase, never by clicking "Remove field" in the
// Studio. `emptyState` is in fact still read below, because the catalog that
// uses it is still code.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SingletonPage from '@/components/SingletonPage.astro';
import CoursesCatalog from '@/components/pinned/CoursesCatalog.astro';
import {
  getCoursesPage,
  getCourses,
  getTeachingAreas,
  getFaculty,
  getTerms,
  getSiteSettings,
} from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { resolveSiteSettings } from '@/lib/siteSettings';

const [page, courses, areas, faculty, terms, siteSettings] = await Promise.all([
  getCoursesPage().catch(() => null),
  getCourses().catch(() => []),
  getTeachingAreas().catch(() => []),
  getFaculty().catch(() => []),
  getTerms().catch(() => []),
  getSiteSettings().catch(() => null),
]);
const settings = resolveSiteSettings(siteSettings);

const title = page?.seoTitle ?? `Courses · ${site.name}`;
const description =
  page?.seoDescription ??
  'Reformed formation taught in person, in cohorts. Browse the catalog by topic or teacher.';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Courses', url: `${site.url}/courses` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} hideFromSearch={page?.hideFromSearch === true}>
  <SingletonPage
    pageType="coursesPage"
    {page}
    {settings}
    heroFallbacks={{
      eyebrow: 'Catalog',
      headline: 'Courses',
      subhead:
        'Reformed formation taught in person, in cohorts. Browse by topic or teacher, and find a place to begin.',
    }}
    finalCtaFallbacks={{
      eyebrow: 'Not sure where to start?',
      headline: 'Tell us what you want to learn',
      subhead: 'We will help you find the right course and point you to a free intro session.',
      cta: { label: 'Request information', linkType: 'external', externalUrl: '/get-started' },
    }}
  >
    <Fragment slot="pinned">
      <CoursesCatalog {courses} {areas} {faculty} {terms} emptyState={page?.emptyState} />
    </Fragment>
  </SingletonPage>
</BaseLayout>
