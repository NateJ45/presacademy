---
// Safe to edit by hand for copy + structure changes.
// Contact page. Address, phone, email, office hours, who-to-contact, a map,
// getting-here notes, and a contact form.
//
// CONVERTED TO THE PAGE BUILDER 2026-08-26 (Phase 2 of
// docs/superpowers/plans/2026-08-26-page-builder-conversion.md). The body is now
// two blocks in the page's "Page sections" array, rendered by SingletonPage:
// `sectionContactDetails` (the details, who-to-reach, getting-here and the map)
// and `sectionForm` on its "page body" style (the same block ordinary pages use,
// so the form renderer and its hCaptcha wiring are not forked). What stays here
// is the queries, the SEO derivation, the breadcrumb JSON-LD, and the photo hero
// (its scoped .hero-fill style has to live in the pages that use it; see the
// note in SingletonPage.astro).
//
// The old contactReasons / whoToReach / gettingHere / form-section fields are
// deliberately left in place and populated (decision D4, additive migration).
// They get unset in the cleanup phase, never by clicking "Remove field".

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getContactPage, getSiteSettings } from '@/lib/queries';
import heroContact from '@/assets/placeholders/acad-table-group.jpg';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { resolveSiteSettings } from '@/lib/siteSettings';
import Hero from '@/components/Hero.astro';
import SingletonPage from '@/components/SingletonPage.astro';

const siteSettings = await getSiteSettings().catch(() => null);
const page = await getContactPage().catch(() => null);

// One resolved settings object; every contact value below comes from Sanity via
// this helper, with no hardcoded site.ts fallbacks.
const settings = resolveSiteSettings(siteSettings);

const title = page?.seoTitle ?? `Contact · ${site.name}`;
const description =
  page?.seoDescription ??
  'Reach The Presbyterian Academy. Address, phone, email, office hours, and how to find the West Chester campus.';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Contact', url: `${site.url}/contact` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} seoImage={page?.seoImage} hideFromSearch={page?.hideFromSearch === true}>
  <SingletonPage
    pageType="contactPage"
    {page}
    {settings}
    finalCtaFallbacks={{
      eyebrow: 'Ready to begin?',
      headline: 'Tell us what you want to learn',
      subhead: 'Request information or book a free intro. No application fee, no pressure.',
      cta: { label: 'Request information', linkType: 'external', externalUrl: '/get-started' },
    }}
  >
    {/* Hero — photo variant, short height. Rendered here rather than inside
        SingletonPage so its scoped style stays on the pages that use it. */}
    <Hero
      slot="hero"
      eyebrow={page?.heroEyebrow ?? 'Contact'}
      headline={page?.heroHeadline ?? 'Get in touch'}
      subhead={page?.heroSubhead ?? 'Questions about a course, scholarships, or getting started? Here is how to reach us.'}
      keyword={page?.heroKeyword}
      backgroundImage={page?.heroImage ?? null}
      localImage={heroContact}
      localImageAlt="A small group studying around a table"
      headingId="contact-hero"
      size="short"
    />
  </SingletonPage>
</BaseLayout>
