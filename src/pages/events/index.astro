---
// Safe to edit by hand for copy + structure changes.
// Events index. Two groups: upcoming one-time events (info sessions, lectures,
// workshops, term starts, deadlines, from Sanity) and the recurring rhythms of
// the Academy. Rule & Ledger layout.
//
// CONVERTED TO THE PAGE BUILDER 2026-08-26 (Phase 2 of
// docs/superpowers/plans/2026-08-26-page-builder-conversion.md). Both groups are
// now blocks in the page's "Page sections" array, rendered by SingletonPage:
// `sectionEventGrid` (upcoming) and `sectionRuledList` (recurring rhythms).
// Each fetches its own slice of the Events collection, so this file no longer
// queries events at all. What stays here is the page query, the SEO derivation
// and the breadcrumb JSON-LD.
//
// The recurring rhythms' three built-in items live in RuledListBlock.astro, the
// same safety net the page carried. If the sections array is ever empty,
// DEFAULT_SECTIONS renders both bands with the page's own headings, including in
// the credential-less CI build.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SingletonPage from '@/components/SingletonPage.astro';
import { getEventsPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { resolveSiteSettings } from '@/lib/siteSettings';

const [page, siteSettings] = await Promise.all([
  getEventsPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);
const settings = resolveSiteSettings(siteSettings);

const title = page?.seoTitle ?? `Events · ${site.name}`;
const description =
  page?.seoDescription ??
  'Info sessions, open lectures, workshops, and term start dates at The Presbyterian Academy. See what is coming up.';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Events', url: `${site.url}/events` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} hideFromSearch={page?.hideFromSearch === true}>
  <SingletonPage
    pageType="eventsPage"
    {page}
    {settings}
    heroFallbacks={{
      eyebrow: 'Events',
      headline: 'Come and see what we do',
      subhead:
        'Free info sessions, open lectures, and workshops, plus the term dates and deadlines you need to plan ahead.',
    }}
    finalCtaFallbacks={{
      eyebrow: 'Want a closer look?',
      headline: 'Book a free intro',
      subhead: 'A short, no-pressure conversation about where you are and what fits.',
      cta: { label: 'Get started', linkType: 'external', externalUrl: '/get-started' },
    }}
  />
</BaseLayout>
