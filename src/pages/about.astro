---
// Safe to edit by hand for copy + structure changes.
// About — the identity page. Mission, Reformed (PC(USA)) identity, What We
// Believe (the distinctives, folded in from the old beliefs page), how we define
// formation, history, and a link to the faculty. Rule & Ledger layout.
//
// CONVERTED TO THE PAGE BUILDER 2026-08-26 (Phase 2 of
// docs/superpowers/plans/2026-08-26-page-builder-conversion.md). The four body
// bands are now blocks in the page's "Page sections" array, rendered by
// SingletonPage: the mission (`sectionEditorialColumns`, labeled), what we
// believe (`sectionNumberedCards`, the warm ledger style), the teach/why pair
// (`sectionEditorialColumns`, pair), and the faculty signpost
// (`sectionInlineBand`). What stays here is the queries, the SEO derivation and
// the breadcrumb JSON-LD.
//
// About's hero is the one that differs from the other six rule-variant pages
// (a 4xl headline measure, a relaxed subhead leading). That difference is kept
// and now lives behind PageHeader's `emphasis="editorial"` prop, set for this
// page in SingletonPage's hero map. PageHeader's header comment records why.
//
// The old mission/believe/teach/why/facultyBand fields are deliberately left in
// place and populated (decision D4, additive migration): reverting this file
// brings the old page back with its content intact. They get unset in the
// cleanup phase, never by clicking "Remove field" in the Studio. If the sections
// array is ever empty, DEFAULT_SECTIONS renders the same four bands the page
// always fell back to, including in the credential-less CI build.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SingletonPage from '@/components/SingletonPage.astro';
import { getAboutPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { resolveSiteSettings } from '@/lib/siteSettings';

const [page, siteSettings] = await Promise.all([
  getAboutPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);
const settings = resolveSiteSettings(siteSettings);

const title = page?.seoTitle ?? `About · ${site.name}`;
const description =
  page?.seoDescription ??
  'A PC(USA) Reformed school of theological formation for adult lay leaders. What we believe, how we teach, and why.';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'About', url: `${site.url}/about` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} hideFromSearch={page?.hideFromSearch === true}>
  <SingletonPage
    pageType="aboutPage"
    {page}
    {settings}
    heroFallbacks={{
      eyebrow: 'About the Academy',
      headline: 'Reformed formation, for the whole church',
      subhead:
        'The Presbyterian Academy teaches the depth of the Reformed tradition to the people who carry the church day to day: elders, teachers, leaders, and ordinary believers who want to know God better.',
    }}
    finalCtaFallbacks={{
      eyebrow: 'Ready to learn?',
      headline: 'Find a course to begin',
      subhead: 'Browse the catalog, meet the teachers, and start when you are ready.',
      cta: { label: 'Browse courses', linkType: 'external', externalUrl: '/courses' },
    }}
  />
</BaseLayout>
