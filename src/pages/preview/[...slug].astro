---
/* ============================================================================
   Preview route — draft-aware pages for the Studio Presentation tool
   (ported from the WCP site, 2026-08-25)
   ============================================================================
   One SSR route renders ANY page in draft mode for the Presentation Tool:
   reads the perspective cookie, fetches the doc draft-aware (stega on), and
   renders it.

    - ALL THIRTEEN singleton pages have now CONVERTED to the page builder
      (2026-08-26: privacy, accessibility, for-you, resources, then pricing,
      about, faq, events, contact, get-started, then courses and faculty, and
      finally home). Each renders through the shared SingletonPage with draft
      data, in full fidelity. Converting a page upgrades its preview
      automatically; add its type to CONVERTED_PAGE_FETCHERS below in the same
      commit.
    - The generic branch below (hero fields + flexibleSections + closing CTA,
      with a note saying the code-owned middle is missing) is therefore reached
      only by `404`, the one singleton the conversion never touched. It stays
      because that is what it is for, and because a new singleton would land
      there before it converts.
    - Any other slug renders the matching custom `page` doc (hero + sections),
      the full page-builder surface.

   Keep the path→type map in sync with SINGLETON_PREVIEW_PATHS in
   studio/resolve.ts. noindex via PreviewLayout.
   ============================================================================ */
export const prerender = false;

import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';
import PreviewLayout from '@/layouts/PreviewLayout.astro';
import Hero from '@/components/Hero.astro';
import Sections from '@/components/Sections.astro';
import FinalCta from '@/components/FinalCta.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import SingletonPage from '@/components/SingletonPage.astro';
import CoursesCatalog from '@/components/pinned/CoursesCatalog.astro';
import FacultyRoster from '@/components/pinned/FacultyRoster.astro';
import { previewFetch } from '@/lib/cms-preview';
import { resolveSiteSettings } from '@/lib/siteSettings';
import {
  IMAGE_PROJECTION,
  SECTION_MEMBERS,
  getHomePage,
  getPrivacyPage,
  getAccessibilityPage,
  getForYouPage,
  getResourcesPage,
  getPricingPage,
  getAboutPage,
  getFaqPage,
  getEventsPage,
  getContactPage,
  getGetStartedPage,
  getCoursesPage,
  getFacultyPage,
  getCourses,
  getTeachingAreas,
  getFaculty,
  getTerms,
  getSiteSettings,
  getNextTerm,
} from '@/lib/queries';

const draftMode = Astro.cookies.has(perspectiveCookieName);
const slug = (Astro.params.slug as string | undefined) || '';

// Fixed preview path → singleton type. Mirror of studio/resolve.ts.
const SINGLETON_BY_PATH: Record<string, string> = {
  '': 'homePage',
  about: 'aboutPage',
  faq: 'faqPage',
  contact: 'contactPage',
  privacy: 'privacyPage',
  accessibility: 'accessibilityPage',
  events: 'eventsPage',
  courses: 'coursesPage',
  faculty: 'facultyPage',
  pricing: 'pricingPage',
  'get-started': 'getStartedPage',
  'for-you': 'forYouPage',
  resources: 'resourcesPage',
  '404': 'notFoundPage',
};

// Every hero/builder/CTA field any of the page types may carry; absent fields
// come back null and the components skip them.
const PREVIEW_FIELDS = `{
  _id, _type, title,
  heroEyebrow, heroHeadline, heroSubhead, heroKeyword,
  heroImage${IMAGE_PROJECTION},
  heroImages[]${IMAGE_PROJECTION},
  seoTitle,
  flexibleSections[]${SECTION_MEMBERS},
  sections[]${SECTION_MEMBERS},
  finalCtaEyebrow, finalCtaHeadline, finalCtaSubhead, finalCta
}`;

interface PreviewDoc {
  _id: string;
  _type: string;
  title?: string;
  heroEyebrow?: string;
  heroHeadline?: string;
  heroSubhead?: string;
  heroImage?: unknown;
  heroImages?: unknown[];
  seoTitle?: string;
  flexibleSections?: any[];
  sections?: any[];
  finalCtaEyebrow?: string;
  finalCtaHeadline?: string;
  finalCtaSubhead?: string;
  finalCta?: any;
}

const singletonType = SINGLETON_BY_PATH[slug];

const draftFetch = (q: string, p: Record<string, unknown> = {}, fallback: any = null) =>
  previewFetch(draftMode, q, p).catch(() => fallback);

// ---------------------------------------------------------------------------
// CONVERTED SINGLETONS: full-fidelity preview (2026-08-26). All thirteen.
// A page that has moved to the builder renders through SingletonPage here, with
// DRAFT data pulled by the same query function the live page uses. That is what
// makes the preview trustworthy: one template, so it cannot drift from the
// page. Add a page's type here in the same commit that converts it.
//
// Three things preview differently from the live page, all accepted:
//   - home's hero renders here too (into the same "hero" slot, as HomeHero), so
//     nothing is missing; what differs is only that its images come from the
//     draft.
//   - the photo heroes render without their LOCAL fallback image (the live
//     pages import it as a build-time asset; this route is SSR). An editor who
//     has set a hero image in Sanity sees that image, which is the thing they
//     are previewing.
//   - resources' empty state is a pinned code region held in ITS page file, so
//     it does not appear here. The courses catalog and the faculty roster are
//     pinned regions too, but they are shared components, so this route fills
//     their slot itself (see the pinned-data block below). Resources' zero state
//     could join them the day it earns a component of its own.
// ---------------------------------------------------------------------------
const CONVERTED_PAGE_FETCHERS: Record<string, (fetcher: any) => Promise<any>> = {
  // Phase 4, 2026-08-26. Home converted last and its special case is GONE: what
  // used to be a bespoke branch rendering HomeBody with seven pre-fetched
  // collections is now this one line plus the hero slot and the auto sections'
  // own draft-aware fetches, below. Home keeps everything the special case gave
  // it (the whole body, draft courses/faculty/testimonials, the next-term line).
  homePage: getHomePage,
  privacyPage: getPrivacyPage,
  accessibilityPage: getAccessibilityPage,
  forYouPage: getForYouPage,
  resourcesPage: getResourcesPage,
  // Phase 2, 2026-08-26.
  pricingPage: getPricingPage,
  aboutPage: getAboutPage,
  faqPage: getFaqPage,
  eventsPage: getEventsPage,
  contactPage: getContactPage,
  getStartedPage: getGetStartedPage,
  // Phase 3, 2026-08-26. Both of these carry a PINNED CODE REGION, fetched
  // below and passed into SingletonPage's "pinned" slot, so the preview shows
  // the whole page and not a page with its middle missing.
  coursesPage: getCoursesPage,
  facultyPage: getFacultyPage,
};

let converted: { page: any; settings: any } | null = null;
if (singletonType && CONVERTED_PAGE_FETCHERS[singletonType]) {
  const [page, siteSettings] = await Promise.all([
    CONVERTED_PAGE_FETCHERS[singletonType](draftFetch),
    getSiteSettings(draftFetch),
  ]);
  converted = { page, settings: resolveSiteSettings(siteSettings) };
}

// ---------------------------------------------------------------------------
// The pinned regions' collection data (Phase 3, 2026-08-26)
// ---------------------------------------------------------------------------
// The courses catalog and the faculty roster are code, not sections, so nothing
// in the sections pipeline fetches what they need. This route fetches it the
// same way the page files do, and for the same reason: the preview is only
// trustworthy if it renders the WHOLE page.
//
// PUBLISHED data on purpose, via the standard query functions. Those four
// collection queries do not take a fetcher yet, and the live page reads them
// published too, so this matches what an editor is previewing. It is the same
// accepted trade the other auto blocks make (the plan's risk register); when a
// draft-aware catalog matters, parameterize the queries and pass draftFetch.
// Home's hero is page-level too, and its ledger line names the next cohort, so
// the term has to be fetched here the way the page file fetches it. Draft-aware,
// because the old home special case fetched it that way (2026-08-26, Phase 4).
const nextTerm =
  converted && singletonType === 'homePage' ? await getNextTerm(draftFetch) : null;

let pinned: Record<string, any> | null = null;
if (converted && singletonType === 'coursesPage') {
  const [courses, areas, faculty, terms] = await Promise.all([
    getCourses().catch(() => []),
    getTeachingAreas().catch(() => []),
    getFaculty().catch(() => []),
    getTerms().catch(() => []),
  ]);
  pinned = { courses, areas, faculty, terms };
} else if (converted && singletonType === 'facultyPage') {
  const [faculty, areas] = await Promise.all([
    getFaculty().catch(() => []),
    getTeachingAreas().catch(() => []),
  ]);
  pinned = { faculty, areas };
}

const doc = converted
  ? null
  : await previewFetch<PreviewDoc | null>(
  draftMode,
  singletonType
    ? `*[_type == $type][0]${PREVIEW_FIELDS}`
    : `*[_type == "page" && slug.current == $slug][0]${PREVIEW_FIELDS}`,
  singletonType ? { type: singletonType } : { slug },
);

if (!converted && !doc) {
  return new Response(`No document found for "${slug || 'home'}"`, { status: 404 });
}
if (converted && !converted.page) {
  return new Response(`No document found for "${slug}"`, { status: 404 });
}

const generic = !converted;

// The doc id the overlay + /preview/live listen on, read from the QUERY (a
// Studio-created page has a random id). Draft perspective can return the
// drafts. twin's id; strip it so the listen filter matches both twins. The
// converted singletons have fixed ids equal to their type.
const pageId = converted ? singletonType : doc!._id.replace(/^drafts\./, '');

const heroHeadline = generic ? doc!.heroHeadline || doc!.title || doc!.seoTitle || '' : '';
const builderSections = generic ? (singletonType ? doc!.flexibleSections : doc!.sections) : [];
const hasFinalCta = generic ? Boolean(doc!.finalCtaHeadline || doc!.finalCta) : false;
const title = converted
  ? singletonType === 'homePage'
    ? 'Home — Preview'
    : `${converted.page?.heroHeadline ?? slug} — Preview`
  : `${doc!.title ?? heroHeadline ?? slug} — Preview`;

// Some converted pages wear the photo hero, which SingletonPage leaves to the
// page (its scoped style must not follow every text-hero page). Here the slot is
// filled from the draft's own hero fields. Keep this set in step with the
// `kind: 'image'` entries in SingletonPage's hero map as those pages convert.
const IMAGE_HERO_TYPES = new Set([
  'privacyPage',
  'accessibilityPage',
  'faqPage',
  'contactPage',
]);
const previewImageHero = Boolean(converted && singletonType && IMAGE_HERO_TYPES.has(singletonType));
---

<PreviewLayout {title} {draftMode} {pageId}>
  {
    converted && (
      <SingletonPage
        pageType={singletonType}
        page={converted.page}
        settings={converted.settings}
        fetcher={singletonType === 'homePage' ? draftFetch : undefined}
      >
        {singletonType === 'homePage' && (
          <HomeHero slot="hero" page={converted.page} settings={converted.settings} {nextTerm} />
        )}
        {previewImageHero && (
          <Hero
            slot="hero"
            eyebrow={converted.page?.heroEyebrow ?? ''}
            headline={converted.page?.heroHeadline ?? ''}
            subhead={converted.page?.heroSubhead ?? ''}
            backgroundImage={converted.page?.heroImage ?? null}
            headingId="preview-hero"
            size="short"
          />
        )}
        {pinned && singletonType === 'coursesPage' && (
          <CoursesCatalog
            slot="pinned"
            courses={pinned.courses}
            areas={pinned.areas}
            faculty={pinned.faculty}
            terms={pinned.terms}
            emptyState={converted.page?.emptyState}
          />
        )}
        {pinned && singletonType === 'facultyPage' && (
          <FacultyRoster
            slot="pinned"
            faculty={pinned.faculty}
            areas={pinned.areas}
            emptyState={converted.page?.emptyState}
          />
        )}
      </SingletonPage>
    )
  }
  {
    heroHeadline && (
      <Hero
        eyebrow={doc.heroEyebrow ?? ''}
        headline={heroHeadline}
        subhead={doc.heroSubhead ?? ''}
        backgroundImage={(doc.heroImage as never) ?? null}
        backgroundImages={(doc.heroImages as never) ?? null}
        headingId="preview-hero"
        size="short"
      />
    )
  }
  {
    generic && singletonType && (
      <div class="mx-auto max-w-3xl px-4 py-6">
        <p class="rounded-md border border-secondary/50 bg-secondary/10 px-4 py-3 text-sm text-ink/80">
          The built-in sections of this page (course rails, stats, filters, contact details) render
          on the live site only. What previews here is what you can edit: the hero above, the
          flexible sections below, and the closing call to action.
        </p>
      </div>
    )
  }
  {generic && <Sections sections={builderSections} />}
  {
    hasFinalCta && (
      <FinalCta
        eyebrow={doc.finalCtaEyebrow}
        headline={doc.finalCtaHeadline}
        subhead={doc.finalCtaSubhead}
        cta={doc.finalCta ?? null}
      />
    )
  }
</PreviewLayout>
