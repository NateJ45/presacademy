---
/* ============================================================================
   Preview route — draft-aware pages for the Studio Presentation tool
   (ported from the WCP site, 2026-08-25)
   ============================================================================
   One SSR route renders ANY page in draft mode for the Presentation Tool:
   reads the perspective cookie, fetches the doc draft-aware (stega on), and
   renders it.

    - `/preview` renders HOME through the shared HomeBody, in full fidelity.
    - A page that has CONVERTED to the page builder (2026-08-26: privacy,
      accessibility, for-you, resources, then pricing, about, faq, events,
      contact, get-started) renders through the shared SingletonPage with draft
      data, also in full fidelity. Converting a page upgrades its preview
      automatically; add its type to CONVERTED_PAGE_FETCHERS below in the same
      commit.
    - The remaining fixed paths (/preview/about, /preview/courses, ...) render
      the matching SINGLETON's generic editable surface: hero fields, the
      flexibleSections page-builder blocks, and the closing CTA. The code-owned
      middle of those pages (course rails, stats, filters) renders only on the
      live site — a note in the preview says so.
    - Any other slug renders the matching custom `page` doc (hero + sections),
      the full page-builder surface.

   Keep the path→type map in sync with SINGLETON_PREVIEW_PATHS in
   studio/resolve.ts. noindex via PreviewLayout.
   ============================================================================ */
export const prerender = false;

import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';
import PreviewLayout from '@/layouts/PreviewLayout.astro';
import Hero from '@/components/Hero.astro';
import Sections from '@/components/Sections.astro';
import FinalCta from '@/components/FinalCta.astro';
import HomeBody from '@/components/home/HomeBody.astro';
import SingletonPage from '@/components/SingletonPage.astro';
import { previewFetch } from '@/lib/cms-preview';
import { resolveSiteSettings } from '@/lib/siteSettings';
import {
  IMAGE_PROJECTION,
  SECTION_MEMBERS,
  getHomePage,
  getPrivacyPage,
  getAccessibilityPage,
  getForYouPage,
  getResourcesPage,
  getPricingPage,
  getAboutPage,
  getFaqPage,
  getEventsPage,
  getContactPage,
  getGetStartedPage,
  getSiteSettings,
  getFeaturedCourses,
  getStartHereCourses,
  getFeaturedFaculty,
  getFeaturedTestimonials,
  getNextTerm,
} from '@/lib/queries';

const draftMode = Astro.cookies.has(perspectiveCookieName);
const slug = (Astro.params.slug as string | undefined) || '';

// Fixed preview path → singleton type. Mirror of studio/resolve.ts.
const SINGLETON_BY_PATH: Record<string, string> = {
  '': 'homePage',
  about: 'aboutPage',
  faq: 'faqPage',
  contact: 'contactPage',
  privacy: 'privacyPage',
  accessibility: 'accessibilityPage',
  events: 'eventsPage',
  courses: 'coursesPage',
  faculty: 'facultyPage',
  pricing: 'pricingPage',
  'get-started': 'getStartedPage',
  'for-you': 'forYouPage',
  resources: 'resourcesPage',
  '404': 'notFoundPage',
};

// Every hero/builder/CTA field any of the page types may carry; absent fields
// come back null and the components skip them.
const PREVIEW_FIELDS = `{
  _id, _type, title,
  heroEyebrow, heroHeadline, heroSubhead, heroKeyword,
  heroImage${IMAGE_PROJECTION},
  heroImages[]${IMAGE_PROJECTION},
  seoTitle,
  flexibleSections[]${SECTION_MEMBERS},
  sections[]${SECTION_MEMBERS},
  finalCtaEyebrow, finalCtaHeadline, finalCtaSubhead, finalCta
}`;

interface PreviewDoc {
  _id: string;
  _type: string;
  title?: string;
  heroEyebrow?: string;
  heroHeadline?: string;
  heroSubhead?: string;
  heroImage?: unknown;
  heroImages?: unknown[];
  seoTitle?: string;
  flexibleSections?: any[];
  sections?: any[];
  finalCtaEyebrow?: string;
  finalCtaHeadline?: string;
  finalCtaSubhead?: string;
  finalCta?: any;
}

const singletonType = SINGLETON_BY_PATH[slug];

// ---------------------------------------------------------------------------
// HOME: full-fidelity preview. The page body is the SHARED HomeBody component
// (also rendered by index.astro), fed here with DRAFT data through the same
// query functions — so what the editor sees IS the page, not an approximation.
// The other singletons still get the generic editable-surface preview below;
// convert them the same way (extract the body, pass a draft fetcher) as they
// earn it.
// ---------------------------------------------------------------------------
const draftFetch = (q: string, p: Record<string, unknown> = {}, fallback: any = null) =>
  previewFetch(draftMode, q, p).catch(() => fallback);

let home: Record<string, any> | null = null;
if (singletonType === 'homePage') {
  const [page, siteSettings, featuredCourses, startHere, featuredFaculty, testimonials, nextTerm] =
    await Promise.all([
      getHomePage(draftFetch),
      getSiteSettings(draftFetch),
      getFeaturedCourses(6, draftFetch),
      getStartHereCourses(draftFetch),
      getFeaturedFaculty(3, draftFetch),
      getFeaturedTestimonials(3, draftFetch),
      getNextTerm(draftFetch),
    ]);
  home = {
    page,
    settings: resolveSiteSettings(siteSettings),
    featuredCourses: featuredCourses ?? [],
    startHere: startHere ?? [],
    featuredFaculty: featuredFaculty ?? [],
    testimonials: testimonials ?? [],
    nextTerm,
  };
}

// ---------------------------------------------------------------------------
// CONVERTED SINGLETONS: full-fidelity preview, same deal as home (2026-08-26).
// A page that has moved to the builder renders through SingletonPage here, with
// DRAFT data pulled by the same query function the live page uses. That is what
// makes the preview trustworthy: one template, so it cannot drift from the
// page. Add a page's type here in the same commit that converts it.
//
// Two things preview differently from the live page, both accepted:
//   - the photo heroes render without their LOCAL fallback image (the live
//     pages import it as a build-time asset; this route is SSR). An editor who
//     has set a hero image in Sanity sees that image, which is the thing they
//     are previewing.
//   - resources' empty state is a pinned code region in the page file, so it
//     does not appear here.
// ---------------------------------------------------------------------------
const CONVERTED_PAGE_FETCHERS: Record<string, (fetcher: any) => Promise<any>> = {
  privacyPage: getPrivacyPage,
  accessibilityPage: getAccessibilityPage,
  forYouPage: getForYouPage,
  resourcesPage: getResourcesPage,
  // Phase 2, 2026-08-26.
  pricingPage: getPricingPage,
  aboutPage: getAboutPage,
  faqPage: getFaqPage,
  eventsPage: getEventsPage,
  contactPage: getContactPage,
  getStartedPage: getGetStartedPage,
};

let converted: { page: any; settings: any } | null = null;
if (!home && singletonType && CONVERTED_PAGE_FETCHERS[singletonType]) {
  const [page, siteSettings] = await Promise.all([
    CONVERTED_PAGE_FETCHERS[singletonType](draftFetch),
    getSiteSettings(draftFetch),
  ]);
  converted = { page, settings: resolveSiteSettings(siteSettings) };
}

const doc = home || converted
  ? null
  : await previewFetch<PreviewDoc | null>(
  draftMode,
  singletonType
    ? `*[_type == $type][0]${PREVIEW_FIELDS}`
    : `*[_type == "page" && slug.current == $slug][0]${PREVIEW_FIELDS}`,
  singletonType ? { type: singletonType } : { slug },
);

if (!home && !converted && !doc) {
  return new Response(`No document found for "${slug || 'home'}"`, { status: 404 });
}
if (converted && !converted.page) {
  return new Response(`No document found for "${slug}"`, { status: 404 });
}

const generic = !home && !converted;

// The doc id the overlay + /preview/live listen on, read from the QUERY (a
// Studio-created page has a random id). Draft perspective can return the
// drafts. twin's id; strip it so the listen filter matches both twins. The
// converted singletons have fixed ids equal to their type, same as home.
const pageId = home ? 'homePage' : converted ? singletonType : doc!._id.replace(/^drafts\./, '');

const heroHeadline = generic ? doc!.heroHeadline || doc!.title || doc!.seoTitle || '' : '';
const builderSections = generic ? (singletonType ? doc!.flexibleSections : doc!.sections) : [];
const hasFinalCta = generic ? Boolean(doc!.finalCtaHeadline || doc!.finalCta) : false;
const title = home
  ? 'Home — Preview'
  : converted
    ? `${converted.page?.heroHeadline ?? slug} — Preview`
    : `${doc!.title ?? heroHeadline ?? slug} — Preview`;

// Some converted pages wear the photo hero, which SingletonPage leaves to the
// page (its scoped style must not follow every text-hero page). Here the slot is
// filled from the draft's own hero fields. Keep this set in step with the
// `kind: 'image'` entries in SingletonPage's hero map as those pages convert.
const IMAGE_HERO_TYPES = new Set([
  'privacyPage',
  'accessibilityPage',
  'faqPage',
  'contactPage',
]);
const previewImageHero = Boolean(converted && singletonType && IMAGE_HERO_TYPES.has(singletonType));
---

<PreviewLayout {title} {draftMode} {pageId}>
  {
    home && (
      <HomeBody
        page={home.page}
        settings={home.settings}
        featuredCourses={home.featuredCourses}
        startHere={home.startHere}
        featuredFaculty={home.featuredFaculty}
        testimonials={home.testimonials}
        nextTerm={home.nextTerm}
      />
    )
  }
  {
    converted && (
      <SingletonPage
        pageType={singletonType}
        page={converted.page}
        settings={converted.settings}
      >
        {previewImageHero && (
          <Hero
            slot="hero"
            eyebrow={converted.page?.heroEyebrow ?? ''}
            headline={converted.page?.heroHeadline ?? ''}
            subhead={converted.page?.heroSubhead ?? ''}
            backgroundImage={converted.page?.heroImage ?? null}
            headingId="preview-hero"
            size="short"
          />
        )}
      </SingletonPage>
    )
  }
  {
    heroHeadline && (
      <Hero
        eyebrow={doc.heroEyebrow ?? ''}
        headline={heroHeadline}
        subhead={doc.heroSubhead ?? ''}
        backgroundImage={(doc.heroImage as never) ?? null}
        backgroundImages={(doc.heroImages as never) ?? null}
        headingId="preview-hero"
        size="short"
      />
    )
  }
  {
    generic && singletonType && (
      <div class="mx-auto max-w-3xl px-4 py-6">
        <p class="rounded-md border border-secondary/50 bg-secondary/10 px-4 py-3 text-sm text-ink/80">
          The built-in sections of this page (course rails, stats, filters, contact details) render
          on the live site only. What previews here is what you can edit: the hero above, the
          flexible sections below, and the closing call to action.
        </p>
      </div>
    )
  }
  {generic && <Sections sections={builderSections} />}
  {
    hasFinalCta && (
      <FinalCta
        eyebrow={doc.finalCtaEyebrow}
        headline={doc.finalCtaHeadline}
        subhead={doc.finalCtaSubhead}
        cta={doc.finalCta ?? null}
      />
    )
  }
</PreviewLayout>
