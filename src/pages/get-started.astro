---
// Safe to edit by hand for copy + structure changes.
// Get Started — the express-interest hub. Express-interest form on the left, a
// ruled panel on the right with the free-intro (Calendly), a "visit a class"
// note, and a syllabus note, then the "what happens next" steps. No payment is
// wired; the form captures interest and routes to a person. Rule & Ledger.
//
// CONVERTED TO THE PAGE BUILDER 2026-08-26 (Phase 2 of
// docs/superpowers/plans/2026-08-26-page-builder-conversion.md). The body is now
// two blocks in the page's "Page sections" array, rendered by SingletonPage:
// `sectionRequestPanel` (form + intro-call panel) and `sectionNumberedCards` on
// its "steps" style. What stays here is the queries, the SEO derivation and the
// breadcrumb JSON-LD.
//
// The booking link's three fallbacks (the section's own field, then
// PUBLIC_CALENDLY_URL, then a mailto) moved into the block with the markup;
// RequestPanelBlock.astro's header explains why all three stay.
//
// The old request*/calendly*/visitClass/syllabus/steps fields are deliberately
// left in place and populated (decision D4, additive migration). They get unset
// in the cleanup phase, never by clicking "Remove field" in the Studio.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SingletonPage from '@/components/SingletonPage.astro';
import { getGetStartedPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { resolveSiteSettings } from '@/lib/siteSettings';

const [page, siteSettings] = await Promise.all([
  getGetStartedPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);
const settings = resolveSiteSettings(siteSettings);

const title = page?.seoTitle ?? `Get Started · ${site.name}`;
const description =
  page?.seoDescription ??
  'Request information, book a free intro, or download a course syllabus. No application fee, no pressure.';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Get Started', url: `${site.url}/get-started` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} hideFromSearch={page?.hideFromSearch === true}>
  <SingletonPage
    pageType="getStartedPage"
    {page}
    {settings}
    heroFallbacks={{
      eyebrow: 'Get started',
      headline: 'Tell us what you want to learn',
      subhead:
        'Request information, book a free intro session, or download a course syllabus. No application fee, no pressure.',
    }}
    finalCtaFallbacks={{
      eyebrow: 'Prefer to browse first?',
      headline: 'See what we teach',
      subhead:
        'The catalog is open. Find a course, meet the teacher, and start when you are ready.',
      cta: { label: 'Browse courses', linkType: 'external', externalUrl: '/courses' },
    }}
  />
</BaseLayout>
