---
// Generic custom pages built in Sanity (the `page` type), routed at /<slug>.
// Static routes (about.astro, contact.astro, etc.) take precedence; this only
// renders slugs that don't collide with a built-in page. With no custom pages
// in Sanity, getStaticPaths returns [] and nothing is generated.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPageBySlug, getAllPageSlugs, getSiteSettings } from '@/lib/queries';
import Hero from '@/components/Hero.astro';
import Sections from '@/components/Sections.astro';
import { site } from '@/data/site';
import { resolveSiteSettings } from '@/lib/siteSettings';
import heroFallback from '@/assets/placeholders/acad-study-overhead.jpg';

export async function getStaticPaths() {
  // Top-level routes that already exist as their own files. A custom page must
  // not reuse these slugs (Astro would see duplicate routes), so we skip them.
  // Defined inside getStaticPaths because Astro hoists this function above the
  // component script (module-scope consts aren't in scope here).
  // 'accessibility' and 'style-guide' joined the list 2026-08-26: both have had
  // their own page files for a while, so a custom page on either slug would
  // have collided at build time. Keep this in step with src/pages/*.astro.
  const RESERVED = new Set([
    'about',
    'contact',
    'courses',
    'faculty',
    'events',
    'resources',
    'pricing',
    'get-started',
    'for-you',
    'faq',
    'privacy',
    'accessibility',
    'style-guide',
    '404',
  ]);
  const slugs = await getAllPageSlugs();
  return slugs.filter((slug) => !RESERVED.has(slug)).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const [page, siteSettings] = await Promise.all([getPageBySlug(slug!), getSiteSettings()]);
const settings = resolveSiteSettings(siteSettings);

// getStaticPaths listed this slug, so an empty answer here is a failed read,
// not a missing page. This route has no /404 redirect: an empty doc would ship
// as a blank page with only the site name. A production build stops instead
// (sibling repo fbcm, 2026-09-24). Dev keeps rendering the empty page.
if (!page && import.meta.env.PROD) {
  throw new Error(
    `[slug] page "${slug}" was listed but came back empty; refusing to publish it as a blank page`,
  );
}

const title = page?.seoTitle ?? page?.title ?? site.name;
const description = page?.seoDescription ?? '';
---

<BaseLayout
  {title}
  {description}
  {siteSettings}
  seoImage={page?.seoImage}
  hideFromSearch={page?.hideFromSearch === true}
>
  <Hero
    eyebrow={page?.heroEyebrow ?? ''}
    headline={page?.heroHeadline ?? page?.title ?? ''}
    subhead={page?.heroSubhead ?? ''}
    backgroundImage={page?.heroImage ?? null}
    localImage={heroFallback}
    localImageAlt="Students working together over books and notes"
    headingId="page-hero"
    size="short"
  />
  <Sections sections={page?.sections} fallbackEmail={settings.email} />
</BaseLayout>
