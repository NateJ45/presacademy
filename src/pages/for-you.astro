---
// Safe to edit by hand for copy + structure changes.
// For You — the lay-persona front door. Each card names who it is for, a
// one-line promise, and a single CTA, so an ordinary adult can self-select a
// starting point without anything resembling admissions UI. Rule & Ledger.
//
// CONVERTED TO THE PAGE BUILDER 2026-08-26 (Phase 1 of
// docs/superpowers/plans/2026-08-26-page-builder-conversion.md). The persona
// cards are now a `sectionNumberedCards` block in the page's "Page sections"
// array, rendered by SingletonPage. What stays here is the queries, the SEO
// derivation and the breadcrumb JSON-LD.
//
// The old `personas` field is deliberately left in place and populated
// (decision D4, additive migration): reverting this file brings the old page
// back with its content intact. It gets unset in the cleanup phase, never by
// clicking "Remove field" in the Studio. If the sections array is ever empty,
// DEFAULT_SECTIONS renders the same four cards the page always fell back to.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SingletonPage from '@/components/SingletonPage.astro';
import { getForYouPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { resolveSiteSettings } from '@/lib/siteSettings';

const [page, siteSettings] = await Promise.all([
  getForYouPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);
const settings = resolveSiteSettings(siteSettings);

const title = page?.seoTitle ?? `For You · ${site.name}`;
const description =
  page?.seoDescription ?? 'However you lead or learn, there is a starting point here for you.';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'For You', url: `${site.url}/for-you` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} hideFromSearch={page?.hideFromSearch === true}>
  <SingletonPage
    pageType="forYouPage"
    {page}
    {settings}
    heroFallbacks={{
      eyebrow: 'Find your path',
      headline: 'Formation for where you are',
      subhead: 'However you lead or learn, there is a starting point here for you.',
    }}
    finalCtaFallbacks={{
      eyebrow: 'Still deciding?',
      headline: 'Talk to a real person',
      subhead: 'Tell us where you are and we will help you find the right place to begin.',
      cta: { label: 'Request information', linkType: 'external', externalUrl: '/get-started' },
    }}
  />
</BaseLayout>
