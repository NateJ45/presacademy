---
// Safe to edit by hand for copy + structure changes.
// Resources — teaching and formation essays from the faculty, free to everyone.
// A content-marketing + SEO surface.
//
// CONVERTED TO THE PAGE BUILDER 2026-08-26 (Phase 1 of
// docs/superpowers/plans/2026-08-26-page-builder-conversion.md). The body of
// this page is now whatever an editor puts in "Page sections"; the file keeps
// only what stays code by doctrine: the queries, the SEO derivation, the
// breadcrumb JSON-LD, and the one region below that is not a section.
//
// Resources was the cheapest page to convert because it was already 90% a
// builder page: its body has always been `flexibleSections`. Nothing about the
// rendered HTML changes.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SingletonPage from '@/components/SingletonPage.astro';
import { getResourcesPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { resolveSiteSettings } from '@/lib/siteSettings';

const [page, siteSettings] = await Promise.all([
  getResourcesPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);
const settings = resolveSiteSettings(siteSettings);

const title = page?.seoTitle ?? `Resources · ${site.name}`;
const description =
  page?.seoDescription ?? 'Short reads on Scripture, theology, and formation, from the faculty of The Presbyterian Academy.';

// The gentle empty state below is deliberately NOT a section type: it is the
// page's zero-state, and it exists precisely for the moment when there are no
// sections to show. Making it a section would mean an editor could delete the
// thing that covers "there is nothing here yet", or (worse) leave it stranded
// above real essays.
const hasSections = (page?.flexibleSections?.length ?? 0) > 0;

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Resources', url: `${site.url}/resources` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} hideFromSearch={page?.hideFromSearch === true}>
  <SingletonPage
    pageType="resourcesPage"
    {page}
    {settings}
    heroFallbacks={{
      eyebrow: 'Resources',
      headline: 'Teaching and formation essays',
      subhead: 'Short reads from our faculty, free to everyone.',
    }}
    finalCtaFallbacks={{
      eyebrow: 'Go deeper',
      headline: 'Learn with the faculty',
      subhead: 'Every essay starts as something the faculty teach. Take the course.',
      cta: { label: 'Browse courses', linkType: 'external', externalUrl: '/courses' },
    }}
  >
    {/* Pinned code region. It renders only when the sections array is empty, so
        it is always adjacent to nothing — which is why sitting in the "pinned"
        slot (after the sections) reproduces the pre-conversion HTML exactly. */}
    <Fragment slot="pinned">
      {!hasSections && (
        <section class="bg-background">
          <div class="mx-auto max-w-content px-m pb-section-lg">
            {page?.emptyStateBody ? (
              <p class="max-w-2xl text-foreground/80 italic">{page.emptyStateBody}</p>
            ) : (
              <p class="max-w-2xl text-foreground/80 italic">
                New essays are on the way. In the meantime, the best way to learn from our faculty is{' '}
                <a href="/courses" class="text-link underline underline-offset-2">in a course</a>.
              </p>
            )}
          </div>
        </section>
      )}
    </Fragment>
  </SingletonPage>
</BaseLayout>
