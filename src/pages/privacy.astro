---
// Safe to edit by hand
// Privacy policy page.
//
// CONVERTED TO THE PAGE BUILDER 2026-08-26 (Phase 1 of
// docs/superpowers/plans/2026-08-26-page-builder-conversion.md). The statement
// body is now a `sectionLegalBody` block in the page's "Page sections" array,
// rendered by SingletonPage. What stays here is what stays code by doctrine:
// the queries, the SEO derivation, the breadcrumb JSON-LD, and the photo hero
// (its scoped .hero-fill style has to live in the pages that use it, or every
// text-hero page inherits the style tag; see the note in SingletonPage.astro).
//
// The old `body` and `lastUpdated` fields are deliberately left in place and
// populated (decision D4, additive migration): reverting this file brings the
// old page back with its content intact. They are unset in the cleanup phase,
// never by clicking "Remove field" in the Studio.
//
// If the sections array is ever empty, DEFAULT_SECTIONS renders the same
// built-in policy the page has always fallen back to, so the page is never
// blank, including in the credential-less CI build.

import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import heroPrivacy from '@/assets/placeholders/acad-library-room.jpg';
import SingletonPage from '@/components/SingletonPage.astro';
import { getPrivacyPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { resolveSiteSettings } from '@/lib/siteSettings';

const [page, siteSettings] = await Promise.all([
  getPrivacyPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);
const settings = resolveSiteSettings(siteSettings);

const title       = page?.seoTitle       ?? `Privacy Policy · ${site.name}`;
const description = page?.seoDescription ?? 'How we handle the information you share when you reach out or subscribe.';

const heroEyebrow  = page?.heroEyebrow  ?? 'Transparency first.';
const heroHeadline = page?.heroHeadline ?? 'Privacy Policy';
const heroSubhead  = page?.heroSubhead  ?? '';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Privacy Policy', url: `${site.url}/privacy` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} seoImage={page?.seoImage}>
  <SingletonPage pageType="privacyPage" {page} {settings}>
    {/* Hero — photo variant, short height. Rendered here rather than inside
        SingletonPage so its scoped style stays on the pages that use it. */}
    <Hero
      slot="hero"
      eyebrow={heroEyebrow}
      headline={heroHeadline}
      subhead={heroSubhead}
      backgroundImage={page?.heroImage ?? null}
      localImage={heroPrivacy}
      localImageAlt="A university library reading room"
      headingId="privacy-hero-heading"
      size="short"
    />
  </SingletonPage>
</BaseLayout>
