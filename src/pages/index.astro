---
// Safe to edit by hand for data wiring; the page BODY lives in
// src/components/home/HomeBody.astro (shared with the Studio's draft preview —
// edit copy and structure THERE so the preview can never drift from the page).
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeBody from '@/components/home/HomeBody.astro';
import {
  getHomePage,
  getSiteSettings,
  getFeaturedCourses,
  getStartHereCourses,
  getFeaturedFaculty,
  getFeaturedTestimonials,
  getNextTerm,
} from '@/lib/queries';
import { site } from '@/data/site';
import { resolveSiteSettings } from '@/lib/siteSettings';

const [page, siteSettings, featuredCourses, startHere, featuredFaculty, testimonials, nextTerm] =
  await Promise.all([
    getHomePage().catch(() => null),
    getSiteSettings().catch(() => null),
    getFeaturedCourses(6).catch(() => []),
    getStartHereCourses().catch(() => []),
    getFeaturedFaculty(3).catch(() => []),
    getFeaturedTestimonials(3).catch(() => []),
    getNextTerm().catch(() => null),
  ]);
const settings = resolveSiteSettings(siteSettings);

const title = page?.seoTitle ?? site.name;
const description =
  page?.seoDescription ??
  'Reformed formation taught in person, in cohorts, for the people who lead the church: elders, teachers, small-group hosts, and the lifelong curious.';
---

<BaseLayout {title} {description} {siteSettings}>
  <HomeBody
    {page}
    {settings}
    {featuredCourses}
    {startHere}
    {featuredFaculty}
    {testimonials}
    {nextTerm}
  />
</BaseLayout>
