---
// Safe to edit by hand for copy + structure changes.
// Faculty directory. A text-forward, filterable roster: every teacher leads
// with honorific + name and the degree-with-institution line directly beneath.
// Rule & Ledger layout with an aggregate trust line up top. Falls back to an
// empty-state line before Sanity is seeded.
//
// CONVERTED TO THE PAGE BUILDER 2026-08-26 (Phase 3 of
// docs/superpowers/plans/2026-08-26-page-builder-conversion.md), the second
// page with a PINNED CODE REGION.
//
// What converted: the hero only. It is the trust-line variant of PageHeader
// (the gold hairline becomes that paragraph's top border), wired through
// SingletonPage's hero map, which names `aggregateTrustLine` as the field.
//
// What did not: the roster. The FacultyFilter island, its area chips, the
// sr-only heading and the empty state stay code by doctrine (the plan's "Stays
// code, deliberately") and render through SingletonPage's "pinned" slot.
//
// NOTHING WAS SEEDED for this page. Its body is entirely the roster, so there
// is no band to move into "Page sections": the array is empty, and an editor
// who adds one gets it between the hero and the roster. That is the pinned
// slot's documented ordering (SingletonPage's header), and it is the sensible
// place for an introduction to the faculty to land.
//
// The old `aggregateTrustLine` and `emptyState` fields stay populated and in
// use: the first now feeds the shared hero, the second the pinned roster.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SingletonPage from '@/components/SingletonPage.astro';
import FacultyRoster from '@/components/pinned/FacultyRoster.astro';
import { getFacultyPage, getFaculty, getTeachingAreas, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { resolveSiteSettings } from '@/lib/siteSettings';

const [page, faculty, areas, siteSettings] = await Promise.all([
  getFacultyPage().catch(() => null),
  getFaculty().catch(() => []),
  getTeachingAreas().catch(() => []),
  getSiteSettings().catch(() => null),
]);
const settings = resolveSiteSettings(siteSettings);

const title = page?.seoTitle ?? `Faculty · ${site.name}`;
const description =
  page?.seoDescription ??
  'Every course is led by an ordained minister or a credentialed Reformed scholar. Meet the faculty of The Presbyterian Academy.';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Faculty', url: `${site.url}/faculty` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} hideFromSearch={page?.hideFromSearch === true}>
  <SingletonPage
    pageType="facultyPage"
    {page}
    {settings}
    heroFallbacks={{
      eyebrow: 'The faculty',
      headline: 'Taught by ministers and scholars',
      subhead: 'The teachers are the heart of the Academy. Get to know them.',
      trustLine: 'Every teacher is an ordained minister or a credentialed Reformed scholar.',
    }}
    finalCtaFallbacks={{
      eyebrow: 'Learn from them',
      headline: 'Find a course to take',
      subhead: 'Every course is taught by the people you just met.',
      cta: { label: 'Browse courses', linkType: 'external', externalUrl: '/courses' },
    }}
  >
    <Fragment slot="pinned">
      <FacultyRoster {faculty} {areas} emptyState={page?.emptyState} />
    </Fragment>
  </SingletonPage>
</BaseLayout>
