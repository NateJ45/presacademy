---
// Safe to edit by hand for copy + structure changes.
// Pricing & Scholarships. The price said plainly: a ruled set of tier cards
// (per course / audit / full track), then a scholarship section and a small
// heritage band. Rule & Ledger layout. No checkout is wired; CTAs route to
// /get-started (express interest).
//
// CONVERTED TO THE PAGE BUILDER 2026-08-26 (Phase 2 of
// docs/superpowers/plans/2026-08-26-page-builder-conversion.md). The three
// bands are now blocks in the page's "Page sections" array, rendered by
// SingletonPage: the tier cards (`sectionPricingTiers` on its Rule & Ledger
// surface), the scholarship promise (`sectionScholarship`), and the heritage
// stat band (`sectionLedgerStats`). What stays here is the queries, the SEO
// derivation and the breadcrumb JSON-LD.
//
// The old `scholarship*`, `footnote` and `stats` fields are deliberately left in
// place and populated (decision D4, additive migration): reverting this file
// brings the old page back with its content intact. They get unset in the
// cleanup phase, never by clicking "Remove field" in the Studio. If the sections
// array is ever empty, DEFAULT_SECTIONS renders the same three bands the page
// always fell back to, including in the credential-less CI build.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SingletonPage from '@/components/SingletonPage.astro';
import { getPricingPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { resolveSiteSettings } from '@/lib/siteSettings';

const [page, siteSettings] = await Promise.all([
  getPricingPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);
const settings = resolveSiteSettings(siteSettings);

const title = page?.seoTitle ?? `Pricing & Scholarships · ${site.name}`;
const description =
  page?.seoDescription ??
  'What a course costs, said plainly, and how we keep Reformed formation within reach.';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Pricing & Scholarships', url: `${site.url}/pricing` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} hideFromSearch={page?.hideFromSearch === true}>
  <SingletonPage
    pageType="pricingPage"
    {page}
    {settings}
    heroFallbacks={{
      eyebrow: 'Tuition',
      headline: 'Pricing and scholarships',
      subhead: 'What a course costs, said plainly, and how we keep formation within reach.',
    }}
    finalCtaFallbacks={{
      eyebrow: 'Questions about cost?',
      headline: 'Ask us, plainly',
      subhead: 'Tell us your situation on the interest form and we will be straight with you.',
      cta: { label: 'Request information', linkType: 'external', externalUrl: '/get-started' },
    }}
  />
</BaseLayout>
