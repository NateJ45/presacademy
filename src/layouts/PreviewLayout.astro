---
/* ============================================================================
   PreviewLayout — Studio-only shell for /preview/* pages
   (ported from the WCP site, 2026-08-25)
   ============================================================================
   Deliberately NOT BaseLayout: skips analytics, canonical/OG tags, Lenis, and
   the theme bootstrap, none of which belong on a draft-content page only the
   Presentation Tool's iframe ever loads. `noindex, nofollow` is non-negotiable
   here — these pages must never appear in search results.

   Chrome-less on purpose (unlike WCP, whose Header/Footer take a linkBase
   prop): presacademy's Header/Footer link to the real site, which would bounce
   the editor's iframe OUT of the preview. A slim bar labels the surface so a
   missing header reads as intentional, not broken.
   ============================================================================ */
import '../styles/globals.css';
import VisualEditingOverlay from '@/components/preview/VisualEditingOverlay.tsx';

interface Props {
  title: string;
  draftMode: boolean;
  /** Doc id this preview renders (e.g. "homePage" or a page doc id). */
  pageId: string;
}
const { title, draftMode, pageId } = Astro.props;
---

<!doctype html>
<html lang="en" data-draft={draftMode ? '1' : '0'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <script is:inline>
      // Before paint: mark whether this preview page is EMBEDDED in the Studio's
      // Presentation iframe. Two behaviors hang off the class (2026-08-27):
      //  - The "Exit preview" button hides when embedded. Inside Presentation it
      //    is a trap: it clears the draft cookie and strands the iframe on the
      //    live site with no Studio connection, and nothing short of reloading
      //    the whole Studio re-runs the enable handshake (an editor hit exactly
      //    this). The way out of Presentation is Presentation's own chrome.
      //  - The slim bar shows a reconnect hint if a page ever renders embedded
      //    but WITHOUT draft mode (a dead session), instead of failing silently.
      if (window.self !== window.top) {
        document.documentElement.classList.add('in-studio-frame');
        if (document.documentElement.dataset.draft !== '1') {
          document.documentElement.classList.add('preview-disconnected');
        }
      }
    </script>
    <style>
      .in-studio-frame [data-exit-preview] {
        display: none;
      }
      [data-reconnect-hint] {
        display: none;
      }
      .in-studio-frame.preview-disconnected [data-reconnect-hint] {
        display: inline;
      }
      .in-studio-frame.preview-disconnected [data-connected-note] {
        display: none;
      }
    </style>
  </head>
  <body class="relative bg-background text-foreground">
    <div
      class="border-border-soft bg-card text-foreground/70 flex items-center justify-between border-b px-4 py-1.5 text-xs"
    >
      <span data-connected-note>Draft preview — the site header and footer render on the live site only.</span>
      <span data-reconnect-hint class="font-semibold"
        >Draft session ended — reload the Studio browser tab to reconnect the preview.</span
      >
    </div>
    <main id="main"><slot /></main>

    {/* The motion system's END states, forced. BaseLayout's IntersectionObserver
        script is not loaded here (this shell is deliberately minimal), and the
        reveal/stagger/kinetic entrances hide content at opacity 0 until it
        runs — so without this block, the shared page bodies (SingletonPage and
        its section blocks) would render INVISIBLE sections in the preview. Mirrors the settle() CSS in
        tests/helpers.ts; keep the two in sync when the motion vocabulary grows.
        (Ken Burns / marquee loops are left running — they are keyframe-driven
        and need no JS.) */}
    <style is:global>
      [data-reveal] {
        opacity: 1 !important;
        translate: 0 0 !important;
      }
      [data-reveal] .reveal-rise {
        clip-path: none !important;
        transform: none !important;
      }
      .eyebrow::before {
        transform: scaleX(1) !important;
      }
      [data-stagger-grid] > * {
        opacity: 1 !important;
        translate: 0 0 !important;
      }
      .hero-entry-stagger > * {
        opacity: 1 !important;
        animation: none !important;
        transform: none !important;
      }
      .kinetic-words .w > span {
        transform: none !important;
        animation: none !important;
      }
      .img-curtain {
        display: none !important;
      }
      .step-connector::after {
        transform: scaleY(1) !important;
      }
    </style>

    {
      draftMode && (
        <>
          <VisualEditingOverlay client:only="react" pageId={pageId} />
          <a
            href="/api/draft-mode/disable"
            data-exit-preview
            class="bg-primary text-primary-foreground hover:bg-primary-dark fixed right-4 bottom-4 z-50 rounded-full px-4 py-2 text-sm font-bold shadow-lg"
          >
            Exit preview
          </a>
        </>
      )
    }

    <script>
      // =======================================================================
      // Keep clicks INSIDE the preview surface (2026-08-26)
      // =======================================================================
      // Section bodies are full of real-site links (/about, /courses, CTAs).
      // Left alone, clicking one navigates the Presentation iframe to the LIVE
      // page, which has no Studio connection: the URL bar, the page navigator,
      // and the edit panel all silently freeze on the previous page while the
      // iframe shows the real site (chrome and all). An editor reported exactly
      // this against production.
      //
      // So: same-origin links with a preview equivalent are remapped into
      // /preview/* (the visual-editing history adapter then reports the new
      // location, and Presentation resolves the document, so the navigator and
      // the edit panel follow the click). Links with NO preview route (detail
      // pages like /courses/<slug>, /api, /studio, external origins) split by
      // context (2026-08-28, editor feedback):
      //  - EMBEDDED in the Studio: the navigation is SUPPRESSED entirely. A
      //    click on a faculty or course card there is an EDIT gesture - the
      //    stega overlay already selects the right field/document - and a live
      //    tab popping open on every card click forced a tab-switch back to
      //    the Studio each time.
      //  - Standalone /preview tab: NEW TAB, as before, so the preview surface
      //    is never hijacked.
      //
      // FIRST_SEGMENT_PREVIEWABLE mirrors SINGLETON_BY_PATH in
      // src/pages/preview/[...slug].astro (plus: any single-segment path is a
      // custom `page` slug, which /preview/<slug> also renders). Keep in sync.
      const FIRST_SEGMENT_PREVIEWABLE = new Set([
        'about', 'faq', 'contact', 'privacy', 'accessibility', 'events',
        'courses', 'faculty', 'pricing', 'get-started', 'for-you', 'resources',
      ]);
      const NEVER_REMAP = new Set(['api', 'studio', 'preview', 'style-guide', '404']);

      document.addEventListener(
        'click',
        (event) => {
          if (event.defaultPrevented || event.button !== 0) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const anchor = (event.target as Element | null)?.closest?.('a[href]');
          if (!(anchor instanceof HTMLAnchorElement)) return;
          if (anchor.target === '_blank' || anchor.hasAttribute('download')) return;

          const embedded = document.documentElement.classList.contains('in-studio-frame');
          const url = new URL(anchor.href, window.location.href);
          // External origin: never let it take over the iframe.
          if (url.origin !== window.location.origin) {
            event.preventDefault();
            if (!embedded) window.open(url.href, '_blank', 'noopener');
            return;
          }
          const path = url.pathname.replace(/\/+$/, '') || '/';
          // Already a preview path, an API call, or a same-page hash: default.
          const first = path === '/' ? '' : path.split('/')[1];
          if (path.startsWith('/preview') || first === 'api') return;
          if (path === window.location.pathname && url.hash) return;

          const segments = path === '/' ? [] : path.slice(1).split('/');
          const previewable =
            path === '/' ||
            (segments.length === 1 && !NEVER_REMAP.has(first)) ||
            (segments.length === 1 && FIRST_SEGMENT_PREVIEWABLE.has(first));

          event.preventDefault();
          if (previewable) {
            window.location.assign(path === '/' ? '/preview' : `/preview${path}`);
          } else if (!embedded) {
            // Standalone tab: detail routes without a preview open in a new tab.
            window.open(url.href, '_blank', 'noopener');
          }
          // Embedded: suppressed. The stega overlay's field selection IS the
          // click's result; the editor stays in the Studio.
        },
        true,
      );
    </script>
  </body>
</html>
